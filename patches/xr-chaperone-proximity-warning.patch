\ No newline at end of file
+}
+
+/// Red-warning strength for the closest tracked pose. Crossing the polygon is
+/// always full danger; inside the area it ramps over `danger_distance`.
+pub fn danger_factor(polygon: &[Vec2], positions: &[Vec3], danger_distance: f32) -> f32 {
+    let distance = positions
+        .iter()
+        .map(|&p| signed_distance_to_polygon(polygon, xz(p)))
+        .fold(f32::INFINITY, f32::min);
+    if distance <= 0.0 {
+        1.0
+    } else if distance >= danger_distance || danger_distance <= 0.0 {
+        0.0
+    } else {
+        1.0 - distance / danger_distance
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn square() -> Vec<Vec2> {
+        vec![
+            Vec2::new(-1.0, -1.0),
+            Vec2::new(1.0, -1.0),
+            Vec2::new(1.0, 1.0),
+            Vec2::new(-1.0, 1.0),
+        ]
+    }
+
+    #[test]
+    fn visibility_increases_toward_and_beyond_boundary() {
+        let polygon = square();
+        assert_eq!(visibility_factor(&polygon, Vec3::ZERO, 0.5, 0.0), 0.0);
+        assert!(
+            (visibility_factor(&polygon, Vec3::new(0.75, 0.0, 0.0), 0.5, 0.0) - 0.5).abs() < 1e-5
+        );
+        assert_eq!(
+            visibility_factor(&polygon, Vec3::new(1.1, 0.0, 0.0), 0.5, 0.0),
+            1.0
+        );
+    }
+
+    #[test]
+    fn closest_tracked_device_controls_visibility() {
+        let polygon = square();
+        let devices = [Vec3::ZERO, Vec3::new(0.9, 0.0, 0.0)];
+        assert!((max_visibility(&polygon, &devices, 0.5, 0.0) - 0.8).abs() < 1e-5);
+    }
+
+    #[test]
+    fn danger_turns_red_near_and_outside_edge() {
+        let polygon = square();
+        assert_eq!(danger_factor(&polygon, &[Vec3::ZERO], 0.2), 0.0);
+        assert!((danger_factor(&polygon, &[Vec3::new(0.9, 0.0, 0.0)], 0.2) - 0.5).abs() < 1e-5);
+        assert_eq!(
+            danger_factor(&polygon, &[Vec3::new(1.1, 0.0, 0.0)], 0.2),
+            1.0
+        );
+    }
+}
