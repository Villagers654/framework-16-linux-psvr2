+static vr::TrackedDeviceIndex_t
+find_openvr_device_index(Devices &devices, xrt_device *xdev)
+{
+	if (xdev == nullptr) {
+		return vr::k_unTrackedDeviceIndexInvalid;
+	}
+
+	for (vr::TrackedDeviceIndex_t i = 0; i < vr::k_unMaxTrackedDeviceCount; ++i) {
+		auto maybe_device = devices.GetDevice(i);
+		if (maybe_device && (*maybe_device)->xdev == xdev) {
+			return i;
+		}
+	}
+
+	return vr::k_unTrackedDeviceIndexInvalid;
 }
 
