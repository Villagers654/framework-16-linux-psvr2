+fn parse_play_area_from_path(path: &Path) -> Option<PlayAreaData> {
+    let data = fs::read(path).ok()?;
+    let info: ChaperoneInfo = serde_json::from_slice(&data).ok()?;
+    info.universes.into_iter().find_map(play_area_from_universe)
+}
+
+fn play_area_from_universe(universe: Universe) -> Option<PlayAreaData> {
+    let collision_bounds = universe.collision_bounds?;
+    if collision_bounds.is_empty() {
+        return None;
+    }
+
+    let mut floor_y = f32::INFINITY;
+    for wall in &collision_bounds {
+        for point in wall {
+            floor_y = floor_y.min(point[1]);
+        }
+    }
+    if !floor_y.is_finite() {
+        return None;
+    }
+
+    let mut floor_points = Vec::<[f32; 3]>::new();
+    for wall in &collision_bounds {
+        for point in wall {
+            if (point[1] - floor_y).abs() <= 0.02 {
+                floor_points.push(*point);
+            }
+        }
+    }
+    if floor_points.is_empty() {
+        return None;
+    }
+
+    let (center_x, center_z, avg_floor_y) = floor_points.iter().fold(
+        (0f32, 0f32, 0f32),
+        |(sum_x, sum_z, sum_y), point| (sum_x + point[0], sum_z + point[2], sum_y + point[1]),
+    );
+    let count = floor_points.len() as f32;
+    let center_x = center_x / count;
+    let center_z = center_z / count;
+    let avg_floor_y = avg_floor_y / count;
+
+    let (mut min_x, mut max_x) = (f32::INFINITY, f32::NEG_INFINITY);
+    let (mut min_z, mut max_z) = (f32::INFINITY, f32::NEG_INFINITY);
+    for wall in &collision_bounds {
+        for point in wall {
+            min_x = min_x.min(point[0]);
+            max_x = max_x.max(point[0]);
+            min_z = min_z.min(point[2]);
+            max_z = max_z.max(point[2]);
+        }
+    }
+    let [size_x, size_z] = universe
+        .play_area
+        .filter(|area| area[0] > 0.0 && area[1] > 0.0)
+        .unwrap_or([max_x - min_x, max_z - min_z]);
+    let (size_x, size_z) = (size_x.max(0.01), size_z.max(0.01));
+
+    let half_x = size_x * 0.5;
+    let half_z = size_z * 0.5;
+    let rect = [
+        vr::HmdVector3_t {
+            v: [center_x - half_x, avg_floor_y, center_z - half_z],
+        },
+        vr::HmdVector3_t {
+            v: [center_x + half_x, avg_floor_y, center_z - half_z],
+        },
+        vr::HmdVector3_t {
+            v: [center_x + half_x, avg_floor_y, center_z + half_z],
+        },
+        vr::HmdVector3_t {
+            v: [center_x - half_x, avg_floor_y, center_z + half_z],
+        },
+    ];
+
+    Some(PlayAreaData { size_x, size_z, rect })
+}
+
+fn current_play_area() -> Option<PlayAreaData> {
+    chaperone_data_path().and_then(|path| parse_play_area_from_path(&path))
+}
+
+fn fallback_play_area() -> PlayAreaData {
+    PlayAreaData {
+        size_x: 1.0,
+        size_z: 1.0,
+        rect: [
+            vr::HmdVector3_t {
+                v: [-0.5, 0.0, -0.5],
+            },
+            vr::HmdVector3_t {
+                v: [0.5, 0.0, -0.5],
+            },
+            vr::HmdVector3_t {
+                v: [0.5, 0.0, 0.5],
+            },
+            vr::HmdVector3_t {
+                v: [-0.5, 0.0, 0.5],
+            },
+        ],
+    }
+}
