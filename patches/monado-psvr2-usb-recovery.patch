+static bool
+psvr2_usb_claim_interface_and_handle_kernel_driver(struct psvr2_hmd *hmd, int intf_no, const char *name)
+{
+	int res;
+	int retry = 1;
+
+resclaim:
+	res = libusb_claim_interface(hmd->dev, intf_no);
+	if (res >= 0) {
+		return true;
+	}
+
+	if (retry > 0 && (res == LIBUSB_ERROR_BUSY || res == LIBUSB_ERROR_NOT_FOUND)) {
+		int active = libusb_kernel_driver_active(hmd->dev, intf_no);
+		if (active > 0) {
+			res = libusb_detach_kernel_driver(hmd->dev, intf_no);
+			PSVR2_INFO(hmd, "Detaching USB %s kernel driver before claim (%s)", name,
+			           res < 0 ? libusb_error_name(res) : "ok");
+			if (res < 0 && res != LIBUSB_ERROR_NOT_FOUND && res != LIBUSB_ERROR_NOT_SUPPORTED) {
+				PSVR2_WARN(hmd, "Failed to detach USB %s kernel driver (%s)", name, libusb_error_name(res));
+			}
+		}
+		retry = 0;
+		goto resclaim;
+	}
+
+	PSVR2_ERROR(hmd, "Failed to claim USB %s interface (%s)", name, libusb_error_name(res));
+	return false;
+}
+
+static bool
+psvr2_usb_open(struct psvr2_hmd *hmd, struct xrt_prober_device *xpdev)
+{
+	int res;
+	for (int attempt = 1; attempt <= PSVR2_USB_OPEN_ATTEMPTS; attempt++) {
+		if (attempt > 1) {
+			PSVR2_WARN(hmd, "Retrying USB open (attempt %d/%d)", attempt, PSVR2_USB_OPEN_ATTEMPTS);
+			os_nanosleep((attempt > 2 ? 4 : 2) * U_TIME_1S_IN_NS / 10);
+		}
+
+		res = libusb_init(&hmd->ctx);
+		if (res < 0) {
+			PSVR2_ERROR(hmd, "Failed to init USB");
+			continue;
+		}
+
+		hmd->dev = libusb_open_device_with_vid_pid(hmd->ctx, xpdev->vendor_id, xpdev->product_id);
+		if (hmd->dev == NULL) {
+			PSVR2_ERROR(hmd, "Failed to open USB device");
+			libusb_exit(hmd->ctx);
+			hmd->ctx = NULL;
+			continue;
+		}
+		res = libusb_set_auto_detach_kernel_driver(hmd->dev, 1);
+		if (res < 0) {
+			PSVR2_WARN(hmd, "Failed to set libusb auto detach for USB device (%s)", libusb_error_name(res));
+		}
+
+		bool interfaces_ok = true;
+		for (size_t i = 0; i < sizeof(interface_list) / sizeof(interface_list[0]); i++) {
+			int intf_no = interface_list[i].interface_no;
+			int altmode = interface_list[i].altmode;
+			const char *name = interface_list[i].name;
+
+			if (!psvr2_usb_claim_interface_and_handle_kernel_driver(hmd, intf_no, name)) {
+				interfaces_ok = false;
+				break;
+			}
+			if (!psvr2_usb_set_interface_alt(hmd, intf_no, altmode, name)) {
+				interfaces_ok = false;
+				break;
+			}
+		}
+
+		if (interfaces_ok) {
+			return true;
+		}
+
+		if (hmd->dev != NULL) {
+			res = libusb_reset_device(hmd->dev);
+			if (res < 0) {
+				PSVR2_WARN(hmd, "Failed to reset USB device during USB-open cleanup (%s)",
+				           libusb_error_name(res));
+			}
+			libusb_close(hmd->dev);
+			hmd->dev = NULL;
+		}
+		if (hmd->ctx != NULL) {
+			libusb_exit(hmd->ctx);
+			hmd->ctx = NULL;
+		}
+	}
+
+	return false;
 }
 
