+fn registered_nonsteam_vr_apps(steam_root: &Path) -> Vec<AppManifest> {
+	let path = steam_root.join("config/steamapps.vrmanifest");
+	let Ok(raw) = std::fs::read_to_string(path) else {
+		return Vec::new();
+	};
+	let Ok(payload) = serde_json::from_str::<serde_json::Value>(&raw) else {
+		return Vec::new();
+	};
+	let Some(applications) = payload.get("applications").and_then(|value| value.as_array()) else {
+		return Vec::new();
+	};
+
+	applications
+		.iter()
+		.filter_map(|entry| {
+			if entry.get("launch_type")?.as_str()? != "binary" {
+				return None;
+			}
+			let app_id = entry.get("app_key")?.as_str()?.strip_prefix("steam.app.")?;
+			if !app_id.chars().all(|value| value.is_ascii_digit()) {
+				return None;
+			}
+			let binary = entry.get("binary_path_linux")?.as_str()?;
+			if !Path::new(binary).is_file() {
+				return None;
+			}
+			let name = entry
+				.get("strings")?
+				.get("en_us")?
+				.get("name")?
+				.as_str()?
+				.to_string();
+			let last_played = entry
+				.get("last_played_time")
+				.and_then(|value| value.as_str())
+				.and_then(|value| value.parse::<u64>().ok());
+			Some(AppManifest {
+				app_id: app_id.into(),
+				run_game_id: app_id.into(),
+				name,
+				raw_state_flags: 4,
+				last_played,
+			})
+		})
+		.collect()
+}
