-		*(bool *)cs.mirror.enable->ptr = true;
+	bool spectator_mode = debug_get_bool_option_spectator_mode();
+
+	// Use the synchronized readback sink for the compositor's undistorted eye.
+	// The native debug image can race the renderer and expose incomplete data.
+	if (spectator_mode && cs.readback.enable != NULL) {
+		*(bool *)cs.readback.enable->ptr = true;
 	}
 
 	// Always set the clear colour.
