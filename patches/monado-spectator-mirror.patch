@@ -127,6 +127,7 @@ struct plot_state
 };
 
 DEBUG_GET_ONCE_BOOL_OPTION(curated_gui, "XRT_CURATED_GUI", false)
+DEBUG_GET_ONCE_BOOL_OPTION(spectator_mode, "XRT_SPECTATOR_MODE", false)
 
 
 /*
@@ -956,9 +957,12 @@ curated_render(struct debug_scene *ds, struct gui_program *p)
 	// Collect the variables.
 	u_var_visit(curated_on_root_enter, curated_on_root_exit, curated_on_elem, &cs);
 
