+fn get_library_folders(vdf_root: &Vdf<'_>) -> Vec<String> {
+	let mut roots = Vec::<String>::new();
+	let obj_libraryfolders = match vdf_root.value.get_obj() {
+		Some(obj) => obj,
+		None => return roots,
+	};
+
+	let mut num = 0;
+	#[allow(clippy::while_let_loop)]
+	loop {
+		let Some(library_folder) = get_obj_first(obj_libraryfolders, format!("{}", num).as_str()) else {
+			break;
+		};
+		let Some(path) = get_str_first(library_folder, "path") else {
+			num += 1;
+			continue;
+		};
+		let expanded = match path.strip_prefix('~') {
+			Some(rest) => {
+				let home = std::env::var("HOME").unwrap_or_default();
+				format!("{}{}", home, rest)
+			}
+			None => path.to_string(),
+		};
+		roots.push(expanded.replace("\\\\", "/").replace('\\', "/"));
+		num += 1;
+	}
+
+	roots
+}
+
+fn parse_manifest_field(raw: &str, key: &str) -> Option<String> {
+	let marker = format!("\"{}\"", key);
+	for line in raw.lines() {
+		let trimmed = line.trim_start();
+		let Some(key_start) = trimmed.find(&marker) else {
+			continue;
+		};
+		if key_start != 0 {
+			continue;
+		}
+
+		let rest = &trimmed[key_start + marker.len()..];
+		let Some(first_quote) = rest.find('"') else {
+			continue;
+		};
+		let value_start = first_quote + 1;
+		let value_and_rest = &rest[value_start..];
+		let Some(second_quote) = value_and_rest.find('"') else {
+			continue;
+		};
+
+		let mut value = value_and_rest[..second_quote].to_string();
+
+		value = value.trim().to_string();
+		if value.is_empty() {
+			continue;
+		}
+
+		return Some(value);
+	}
+
+	None
+}
+
+fn app_manifest_from_raw(app_id: AppID, raw: &str) -> Option<AppManifest> {
+	let name = parse_manifest_field(raw, "name").unwrap_or_else(|| format!("App {}", app_id));
+	let raw_state_flags = parse_manifest_field(raw, "StateFlags").and_then(|value| value.parse::<u64>().ok()).unwrap_or(0);
+	let last_played = parse_manifest_field(raw, "LastPlayed").and_then(|value| value.parse::<u64>().ok());
+
+	Some(AppManifest {
+		app_id: app_id.clone(),
+		run_game_id: app_id,
+		name,
+		raw_state_flags,
+		last_played,
+	})
+}
