+	let raw_state_flags = parse_manifest_field(raw, "StateFlags").and_then(|value| value.parse::<u64>().ok()).unwrap_or(0);
+	let last_played = parse_manifest_field(raw, "LastPlayed").and_then(|value| value.parse::<u64>().ok());
+
+	Some(AppManifest {
+		app_id: app_id.clone(),
+		run_game_id: app_id,
+		name,
+		raw_state_flags,
+		last_played,
+	})
+}
