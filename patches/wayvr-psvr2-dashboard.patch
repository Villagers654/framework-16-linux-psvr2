+const SCREENSHOT_CHORD_WINDOW: Duration = Duration::from_millis(500);
+
+#[derive(Default)]
+struct ScreenshotChord {
+    ps_pressed_at: Option<Instant>,
+    trigger_was_held: bool,
+}
+
+impl ScreenshotChord {
+    fn update(&mut self, ps_started: bool, trigger_held: bool, now: Instant) -> bool {
+        if ps_started {
+            self.ps_pressed_at = Some(now);
+        }
+
+        let trigger_started = trigger_held && !self.trigger_was_held;
+        self.trigger_was_held = trigger_held;
+        let armed = self
+            .ps_pressed_at
+            .is_some_and(|pressed| now.duration_since(pressed) <= SCREENSHOT_CHORD_WINDOW);
+
+        if trigger_started && armed {
+            self.ps_pressed_at = None;
+            true
+        } else {
+            if self
+                .ps_pressed_at
+                .is_some_and(|pressed| now.duration_since(pressed) > SCREENSHOT_CHORD_WINDOW)
+            {
+                self.ps_pressed_at = None;
+            }
+            false
+        }
+    }
+}
 
