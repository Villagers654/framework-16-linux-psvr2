+#[cfg(test)]
+mod screenshot_chord_tests {
+    use super::*;
+
+    #[test]
+    fn ps_pulse_then_trigger_captures() {
+        let start = Instant::now();
+        let mut chord = ScreenshotChord::default();
+        assert!(!chord.update(true, false, start));
+        assert!(!chord.update(false, false, start + Duration::from_millis(100)));
+        assert!(chord.update(false, true, start + Duration::from_millis(400)));
+    }
+
+    #[test]
+    fn trigger_without_ps_does_not_capture() {
+        let mut chord = ScreenshotChord::default();
+        assert!(!chord.update(false, true, Instant::now()));
+    }
+
+    #[test]
+    fn expired_ps_press_does_not_capture() {
+        let start = Instant::now();
+        let mut chord = ScreenshotChord::default();
+        assert!(!chord.update(true, false, start));
+        assert!(!chord.update(false, true, start + Duration::from_millis(600)));
+    }
+
+    #[test]
+    fn one_ps_press_captures_only_once() {
+        let start = Instant::now();
+        let mut chord = ScreenshotChord::default();
+        assert!(!chord.update(true, false, start));
+        assert!(chord.update(false, true, start + Duration::from_millis(100)));
+        assert!(!chord.update(false, false, start + Duration::from_millis(200)));
+        assert!(!chord.update(false, true, start + Duration::from_millis(300)));
+    }
+}
