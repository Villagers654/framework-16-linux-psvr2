#!/usr/bin/bash
set -u

usb_root=${PSVR2_USB_ROOT:-/sys/bus/usb/devices}
drm_root=${PSVR2_DRM_ROOT:-/sys/class/drm}
link_stability_checks=${PSVR2_LINK_STABILITY_CHECKS:-4}
link_disconnect_checks=${PSVR2_LINK_DISCONNECT_CHECKS:-2}
link_check_interval=${PSVR2_LINK_STABILITY_INTERVAL_SECONDS:-1}
startup_retry_base=${PSVR2_STARTUP_RETRY_BASE_SECONDS:-12}
startup_retry_max=${PSVR2_STARTUP_RETRY_MAX_SECONDS:-120}
startup_retry_attempts=${PSVR2_STARTUP_RETRY_ATTEMPTS:-3}
openvr_failure_streak_threshold=${PSVR2_OPENVR_FAILURE_STREAK_THRESHOLD:-2}
openvr_recovery_cooldown=${PSVR2_OPENVR_FAILURE_RECOVERY_SECONDS:-90}
runtime_failure_streak_threshold=${PSVR2_RUNTIME_FAILURE_STREAK_THRESHOLD:-$openvr_failure_streak_threshold}
runtime_recovery_cooldown=${PSVR2_RUNTIME_FAILURE_RECOVERY_SECONDS:-$openvr_recovery_cooldown}
runtime_retry_cooldown=${PSVR2_RUNTIME_RETRY_COOLDOWN_SECONDS:-$runtime_recovery_cooldown}
required_usb_interfaces=${PSVR2_USB_INTERFACE_MINIMUM:-11}
suppress_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-autostart-suppressed"
cooldown_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-startup-cooldown"
runtime_failure_state_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-startup-failure-state"
runtime_test_state_file="${PSVR2_TEST_RUNTIME_STATE_FILE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-runtime-active-test}"
connection_state_file="${PSVR2_CONNECTION_STATE_FILE:-}"
helper_dir="${PSVR2_HELPER_DIR:-$HOME/.local/bin}"
start_helper="$helper_dir/psvr2-fossvr-start"
stop_helper="$helper_dir/psvr2-fossvr-stop"
bluetoothctl_bin=$(command -v bluetoothctl 2>/dev/null || true)
next_retry=0
runtime_failure_streak=0
required_controller_count="${PSVR2_REQUIRED_CONTROLLER_COUNT:-2}"
wayvr_role_retry_interval="${PSVR2_WAYVR_ROLE_RETRY_SECONDS:-8}"
wayvr_input_retry_interval="${PSVR2_WAYVR_INPUT_RETRY_SECONDS:-8}"

load_runtime_failure_state() {
    if [[ -r "$runtime_failure_state_file" ]]; then
        local count
        count=$(cat "$runtime_failure_state_file" 2>/dev/null || echo 0)
        if [[ "$count" =~ ^[0-9]+$ ]]; then
            runtime_failure_streak=$count
        fi
    fi
}

persist_runtime_failure_state() {
    printf '%s\n' "$runtime_failure_streak" > "$runtime_failure_state_file"
}

clear_runtime_failure_state() {
    rm -f "$runtime_failure_state_file"
    runtime_failure_streak=0
}

clear_runtime_state() {
    clear_runtime_failure_state
    clear_runtime_cooldown
}

for helper in "$start_helper" "$stop_helper"; do
    if [[ ! -x "$helper" ]]; then
        echo "Required PSVR2 helper is missing or not executable: $helper" >&2
        exit 1
    fi
done

headset_connected() {
    if [[ -n "$connection_state_file" && -r "$connection_state_file" ]]; then
        case "$(tr -d '[:space:]' < "$connection_state_file")" in
            connected) return 0 ;;
            disconnected) return 1 ;;
            *) return 1 ;;
        esac
    fi

    # The adapter exposes a 12 Mbps USB control function even when the HMD is
    # powered off. Starting Sony's driver in that state makes it address the
    # unavailable camera interfaces and can wedge the AMD xHCI controller.
    # Require the separate 5 Gbps PSVR2 function before declaring it ready.
    local usb_device speed usb_interface_count
    local superspeed_ready=0
    for usb_device in "$usb_root"/*; do
        [[ -r "$usb_device/idVendor" && -r "$usb_device/idProduct" && -r "$usb_device/speed" ]] || continue
        [[ "$(<"$usb_device/idVendor"):$(<"$usb_device/idProduct")" == 054c:0cde ]] || continue
        speed=$(cat "$usb_device/speed")
        usb_interface_count=$(cat "$usb_device/bNumInterfaces" 2>/dev/null || echo 0)
        if awk -v speed="$speed" 'BEGIN { exit !(speed >= 5000) }'; then
            if (( usb_interface_count >= required_usb_interfaces )); then
                superspeed_ready=1
                break
            fi
        fi
    done
    (( superspeed_ready )) || return 1
    local connector
    for connector in "$drm_root"/card*-*; do
        [[ -r "$connector/status" && -r "$connector/edid" ]] || continue
        [[ "$(<"$connector/status")" == connected ]] || continue
        LC_ALL=C grep -aFq 'PS VR2' "$connector/edid" 2>/dev/null && return 0
    done
    return 1
}

headset_state_stable() {
    local target=$1
    local timeout_seconds=$2
    local checks_needed=$3
    local checks=0
    local deadline=$((SECONDS + timeout_seconds))
    while (( SECONDS < deadline )); do
        if headset_connected; then
            if (( target == 1 )); then
                checks=$((checks + 1))
            else
                checks=0
            fi
        else
            if (( target == 0 )); then
                checks=$((checks + 1))
            else
                checks=0
            fi
        fi
        (( checks >= checks_needed )) && return 0
        sleep "$link_check_interval"
    done
    return 1
}

has_runtime_cooldown() {
    if [[ ! -r "$cooldown_file" ]]; then
        return 1
    fi
    local now until
    now=$(date +%s)
    until=$(cat "$cooldown_file" 2>/dev/null | tr -cd '0-9' )
    until="${until:-0}"
    if (( now < until )); then
        echo "PSVR2 startup is under cool-down protection for $((until - now))s" >&2
        return 0
    fi
    rm -f "$cooldown_file"
    return 1
}

set_runtime_cooldown() {
    local seconds=$1
    local until=$(( $(date +%s) + seconds ))
    printf '%s\n' "$until" > "$cooldown_file"
}

clear_runtime_cooldown() {
    rm -f "$cooldown_file"
}

controller_count() {
    local count=0 product file
    for product in 0E45 0E46; do
        for file in /sys/class/hidraw/hidraw*/device/uevent; do
            [[ -r "$file" ]] || continue
            if grep -Fq "HID_ID=0005:0000054C:0000${product}" "$file"; then
                count=$((count + 1)); break
            fi
        done
    done
    printf '%s\n' "$count"
}

bluetooth_controller_count() {
    local count=0 address name line
    if [[ -z "$bluetoothctl_bin" ]]; then
        printf '%s\n' 0
        return
    fi
    while IFS= read -r line; do
        address=$(awk '{print $2; exit}' <<<"$line")
        name=$(awk '{$1=$2=""; sub(/^  /, "", $0); print $0}' <<<"$line")
        [[ -n "$address" ]] || continue
        [[ -n "$name" ]] || continue

        if [[ "$name" == *"PlayStation VR2 Sense Controller"* ]] \
            || [[ "$name" == *"PS VR2 Sense Controller"* ]] \
            || [[ "$name" == *"Sense Controller (L)"* ]] \
            || [[ "$name" == *"Sense Controller (R)"* ]]; then
            if "$bluetoothctl_bin" info "$address" 2>/dev/null | grep -q 'Connected: yes'; then
                count=$((count + 1))
            fi
        fi
    done < <("$bluetoothctl_bin" devices 2>/dev/null)
    printf '%s\n' "$count"
}

connected_controller_count() {
    local count_hid count_bt
    count_hid=$(controller_count)
    count_bt=$(bluetooth_controller_count)
    if (( count_bt > count_hid )); then
        printf '%s\n' "$count_bt"
    else
        printf '%s\n' "$count_hid"
    fi
}

extract_controller_role() {
    local device_side=$1 logs=$2 line value
    line=$(grep -m 1 -E "^[[:space:]]*${device_side}:" <<<"$logs" | tail -n 1 || true)
    if [[ -z "$line" ]]; then
        return 1
    fi
    value=$(sed -E "s/^[[:space:]]*${device_side}:[[:space:]]*//; s/[[:space:]]+$//" <<<"$line")
    value=${value// /}
    if [[ -z "$value" ]]; then
        return 1
    fi
    if [[ "$value" == -1 ]]; then
        return 1
    fi
    if [[ "$value" == "<none>" || "$value" == "<none/>" || "$value" == "none" ]]; then
        return 1
    fi
    if [[ "$value" == "<none>"* ]]; then
        return 1
    fi
    if [[ "$value" == *"(<none>)" ]]; then
        return 1
    fi
    printf '%s\n' "$value"
    return 0
}

monado_controller_roles_ready() {
    local log_lines="${PSVR2_MONADO_CONTROLLER_LOG_LINES:-240}"
    local monado_pid logs left_line right_line

    if (( required_controller_count == 0 )); then
        return 0
    fi

    monado_pid=$(systemctl --user show psvr2-fossvr.service -p MainPID --value 2>/dev/null || echo 0)
    if [[ -z "${monado_pid}" || "${monado_pid}" == "0" ]]; then
        return 1
    fi

    logs=$(journalctl --user -u psvr2-fossvr.service "_PID=${monado_pid}" -o cat -n "$log_lines" --no-pager 2>/dev/null || true)
    if [[ -z "$logs" ]]; then
        return 1
    fi

    left_line=$(grep -m 1 -E "^[[:space:]]*left:" <<<"$logs" | tail -n 1 || true)
    right_line=$(grep -m 1 -E "^[[:space:]]*right:" <<<"$logs" | tail -n 1 || true)
    if [[ -z "$left_line" || -z "$right_line" ]]; then
        return 1
    fi

    left_line=${left_line// /}
    right_line=${right_line// /}
    [[ "$left_line" == *"<none>"* || "$left_line" == *"(<none>)"* ]] && return 1
    [[ "$right_line" == *"<none>"* || "$right_line" == *"(<none>)"* ]] && return 1
    return 0
}

wayvr_controller_inputs_ready() {
    local wayvr_pid logs selection_block left_line right_line line
    local wayvr_log_lines="${PSVR2_WAYVR_CONTROLLER_LOG_LINES:-220}"

    wayvr_pid=$(systemctl --user show psvr2-fossvr-wayvr.service -p MainPID --value 2>/dev/null || echo 0)
    if [[ -z "$wayvr_pid" || "$wayvr_pid" == "0" ]]; then
        return 1
    fi

    logs=$(journalctl --user -u psvr2-fossvr-wayvr.service "_PID=$wayvr_pid" -o cat -n "$wayvr_log_lines" --no-pager 2>/dev/null || true)
    if [[ -z "$logs" ]]; then
        return 1
    fi

    # WayVR prints a deterministic "Selected devices" block at startup:
    #   Head: ...
    #   Left: ...
    #   Right: ...
    # We care about the latest block, which appears at the bottom of the log.
    selection_block=$(awk '
        /LOG in xrGetSystem: Selected devices/ { in_sel = 1; next }
        in_sel && $0 ~ /Hand-Tracking Left \(unobstructed\):/ { in_sel = 0 }
        in_sel { print }
        in_sel && /Right:/ { right = $0 }
        in_sel && /Left:/ { left = $0 }
        END {
            if (left != "") print "left=" left;
            if (right != "") print "right=" right;
        }
    ' <<<"$logs")

    left_line=$(awk -F'left=' '/^left=/{print $2; exit}' <<<"$selection_block")
    right_line=$(awk -F'right=' '/^right=/{print $2; exit}' <<<"$selection_block")

    if [[ -z "$left_line" || -z "$right_line" ]]; then
        return 1
    fi

    left_line=${left_line// /}
    right_line=${right_line// /}
    [[ "$left_line" == "<none>"* || "$left_line" == *"(<none>)"* ]] && return 1
    [[ "$right_line" == "<none>"* || "$right_line" == *"(<none>)"* ]] && return 1
    return 0
}

ensure_monado_controller_roles() {
    local controllers=$1 now=$2
    local last_restart_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-last-wayvr-role-retry"
    local last_input_restart_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-last-wayvr-input-retry"
    local now_epoch

    # keep this check lightweight: no monado restart is required just to expose
    # roles; startup and device discovery are handled by the normal pipeline.
    if (( controllers < required_controller_count )); then
        return 0
    fi

    # Recent changes in WayVR/Monado log formatting can omit role lines in Monado logs
    # even when controller devices are exposed to OpenXR. In that case, use WayVR's
    # selected-devices report (left/right) as the authoritative signal.
    if wayvr_controller_inputs_ready; then
        return 0
    fi

    if monado_controller_roles_ready; then
        return 0
    fi

    now_epoch=$(date +%s)
    if [[ -n "$now" ]]; then
        now_epoch=$now
    fi
    if [[ -r "$last_restart_file" ]]; then
        last_restart=$(cat "$last_restart_file" 2>/dev/null || echo 0)
    else
        last_restart=0
    fi
    if (( now_epoch - last_restart < wayvr_role_retry_interval )); then
        return 1
    fi

    if [[ -r "$last_input_restart_file" ]]; then
        last_restart=$(cat "$last_input_restart_file" 2>/dev/null || echo 0)
    else
        last_restart=0
    fi
    if (( now_epoch - last_restart >= wayvr_input_retry_interval )); then
        echo "$now_epoch" > "$last_input_restart_file"
        echo "PSVR2 detected controllers absent in WayVR selected-device input; restarting WayVR only"
        systemctl --user restart psvr2-fossvr-wayvr.service || true
        return 1
    fi

    echo "$now_epoch" > "$last_restart_file"
    echo "PSVR2 detected controllers without assigned roles; restarting WayVR only"
    systemctl --user restart psvr2-fossvr-wayvr.service || true
    return 1
}

is_runtime_active() {
    if [[ "${PSVR2_TEST_MODE:-0}" == "1" && -r "$runtime_test_state_file" ]]; then
        [[ "$(cat "$runtime_test_state_file")" == active ]]
        return
    fi
    local state
    state=$(systemctl --user show psvr2-fossvr.service -p ActiveState --value 2>/dev/null || echo inactive)
    [[ "$state" == active || "$state" == activating ]]
}

runtime_failure_log_contains_critical_failure() {
    if [[ "${PSVR2_TEST_MODE:-0}" == "1" ]]; then
        return 1
    fi

    local lines=${1:-160}
    local result
    result=$(journalctl --user -u psvr2-fossvr.service -n "$lines" --no-pager 2>/dev/null || true)
    grep -Fq "OpenVR driver initialization failed: error 200" <<<"$result" && return 0
    grep -Fq "XRT_ERROR_DEVICE_CREATION_FAILED" <<<"$result" && return 0
    grep -Fq "Unable to create devices" <<<"$result" && return 0
    grep -Fq "Monado failed to start" <<<"$result" && return 0
    grep -Fq "Selected lighthouse because it was certain it could create a head" <<<"$result" && return 0
    if grep -Fq "No builder selected in config (or wasn't compiled in)" <<<"$result" && \
        grep -Fq "Selected lighthouse because it was certain it could create a head" <<<"$result"; then
        return 0
    fi
    grep -Fq "Unable to find HMD" <<<"$result" && return 0
    return 1
}

full_recovery_cycle() {
    echo "PSVR2 startup retries repeatedly hit a hard runtime failure; performing full recovery"
    systemctl --user stop psvr2-fossvr-wayvr.service psvr2-fossvr.service 2>/dev/null || true
    PSVR2_AUTOMATED_STOP=1 "$stop_helper" || true
    if [[ "${PSVR2_TEST_MODE:-0}" == "1" ]]; then
        printf '%s\n' inactive > "$runtime_test_state_file"
    fi
    [[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monado_comp_ipc" ]] && rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monado_comp_ipc"
    systemctl --user stop monado.service monado.socket 2>/dev/null || true
    sleep 3
    clear_runtime_failure_state
    set_runtime_cooldown "$runtime_retry_cooldown"
}

start_runtime() {
    local attempt backoff stable_timeout delay
    backoff=$startup_retry_base
    stable_timeout=$((link_stability_checks * link_check_interval))

    if has_runtime_cooldown; then
        next_retry=$((SECONDS + startup_retry_base))
        return 1
    fi

    if ! headset_state_stable 1 "$stable_timeout" "$link_stability_checks"; then
        echo "PSVR2 USB/DisplayPort link is not stable yet; retrying in ${backoff}s" >&2
        next_retry=$((SECONDS + backoff))
        return 1
    fi

    for attempt in $(seq 1 "$startup_retry_attempts"); do
        delay=$((2 * link_check_interval + 1))
        echo "PSVR2 startup attempt $attempt/$startup_retry_attempts"
        sleep "$delay"
        if ! headset_connected; then
            next_retry=$((SECONDS + backoff))
            return 1
        fi

        if "$start_helper"; then
            if [[ "${PSVR2_TEST_MODE:-0}" == "1" ]]; then
                printf '%s\n' active > "$runtime_test_state_file"
            fi
            next_retry=0
            clear_runtime_cooldown
            clear_runtime_failure_state
            return 0
        fi

        echo "PSVR2 runtime was not healthy; retrying after cleanup" >&2
        if runtime_failure_log_contains_critical_failure 220; then
            runtime_failure_streak=$((runtime_failure_streak + 1))
            persist_runtime_failure_state
            if (( runtime_failure_streak >= runtime_failure_streak_threshold )); then
                full_recovery_cycle
                next_retry=$((SECONDS + runtime_recovery_cooldown))
                return 1
            fi
            set_runtime_cooldown "$runtime_retry_cooldown"
            if [[ "${PSVR2_TEST_MODE:-0}" == "1" ]]; then
                printf '%s\n' inactive > "$runtime_test_state_file"
            fi
            PSVR2_AUTOMATED_STOP=1 "$stop_helper" || true
            return 1
        else
            clear_runtime_failure_state
        fi

        if [[ "${PSVR2_TEST_MODE:-0}" == "1" ]]; then
            printf '%s\n' inactive > "$runtime_test_state_file"
        fi
        PSVR2_AUTOMATED_STOP=1 "$stop_helper" || true

        if (( attempt < startup_retry_attempts )); then
            next_retry=$((SECONDS + backoff))
            if (( backoff < startup_retry_max )); then
                backoff=$((backoff * 2))
                if (( backoff > startup_retry_max )); then
                    backoff=$startup_retry_max
                fi
            fi
            sleep "$backoff"
        fi
    done

    echo "PSVR2 failed to start after ${startup_retry_attempts} attempts; retrying startup" >&2
    next_retry=$((SECONDS + backoff))
    set_runtime_cooldown "$runtime_retry_cooldown"
    return 1
}

load_runtime_failure_state

if [[ "${1:-}" == --probe ]]; then
    headset_connected && { echo connected; exit 0; }
    echo disconnected
    exit 1
fi

if is_runtime_active; then
    previous=connected
else
    previous=disconnected
fi
previous_controllers=$(connected_controller_count)

while true; do
    if headset_connected; then current=connected; else current=disconnected; fi
    if [[ "$current" != "$previous" ]]; then
        if [[ "$current" == connected ]]; then
            echo "PSVR2 USB and DisplayPort connected; validating stable link"
            if headset_state_stable 1 "$((link_stability_checks * link_check_interval))" "$link_stability_checks"; then
                start_runtime || true
                previous=$current
                previous_controllers=$(connected_controller_count)
            else
                next_retry=$((SECONDS + startup_retry_base))
                # Keep previous state until we actually see a sustained link.
                continue
            fi
        else
            if headset_state_stable 0 "$((link_disconnect_checks * link_check_interval))" "$link_disconnect_checks"; then
                echo "PSVR2 USB or DisplayPort disconnected; stopping VR runtime"
                if is_runtime_active; then
                    if [[ "${PSVR2_TEST_MODE:-0}" == "1" ]]; then
                        printf '%s\n' inactive > "$runtime_test_state_file"
                    fi
                    PSVR2_AUTOMATED_STOP=1 "$stop_helper" || true
                fi
                rm -f "$suppress_file"
                clear_runtime_state
                next_retry=0
                previous=$current
                previous_controllers=$(connected_controller_count)
            fi
            # transient disconnects are ignored to avoid restart loops while
            # Sony's USB/DisplayPort links re-negotiate.
            if [[ "$previous" == connected ]]; then
                continue
            fi
        fi
    elif [[ "$current" == connected ]]; then
        controllers=$(connected_controller_count)
        now=$(date +%s)
        ensure_monado_controller_roles "$controllers" "$now" || true
        previous_controllers=$controllers
        if is_runtime_active && ! systemctl --user is-active --quiet psvr2-fossvr-wayvr.service; then
            echo "PSVR2 WayVR dashboard is not running while runtime is active; restarting it"
            systemctl --user restart psvr2-fossvr-wayvr.service || true
        fi
        if ! is_runtime_active \
            && [[ ! -e "$suppress_file" ]] && (( SECONDS >= next_retry )); then
            if headset_state_stable 1 "$((link_stability_checks * link_check_interval))" "$link_stability_checks"; then
                echo "PSVR2 is connected but runtime is not healthy; retrying startup"
                start_runtime || true
            else
                next_retry=$((SECONDS + startup_retry_base))
            fi
        fi
    fi
    sleep 2
done
