#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

steamvr="$STEAM_ROOT/steamapps/common/SteamVR"
sony="$STEAM_ROOT/steamapps/common/PlayStation VR2 App/SteamVR_Plug-In"
vrenv="$steamvr/bin/vrenv.sh"
compositor="$steamvr/bin/linux64/vrcompositor-launcher.sh"
vrstartup="$steamvr/bin/vrstartup.sh"
ignition="$sony/bin/linux64/launch_serverhelper.sh"
webhelper="$steamvr/bin/vrwebhelper/linux64/vrwebhelper"
settings="$STEAM_ROOT/config/steamvr.vrsettings"
helper_dir="${PSVR2_HELPER_DIR:-$HOME/.local/bin}"
lock_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec 8>"$lock_dir/psvr2-fossvr-start.lock"
flock 8

"$helper_dir/psvr2-runtime-preflight" || true

# Keep 120 Hz, the runtime-recommended 1.7x target, supersample filtering, and
# native frames. Linux motion smoothing caused visible ghosting in testing.
if [[ -f "$settings" ]]; then
    tmp=$(mktemp "${settings}.XXXXXX")
    awk -v hz="$PSVR2_REFRESH_RATE" '
      BEGIN { in_vr=0 }
      /^[[:space:]]*"steamvr"[[:space:]]*:[[:space:]]*\{/ {
        print; print "      \"allowSupersampleFiltering\" : true,"
        print "      \"motionSmoothing\" : false,"
        print "      \"preferredRefreshRate\" : " hz ","
        print "      \"supersampleManualOverride\" : true,"
        print "      \"supersampleScale\" : 1.0,"; in_vr=1; next
      }
      in_vr && /"(allowSupersampleFiltering|motionSmoothing|preferredRefreshRate|supersampleManualOverride|supersampleScale)"[[:space:]]*:/ { next }
      in_vr && /^[[:space:]]*}[,]?[[:space:]]*$/ { in_vr=0 }
      { gsub(/"enableHomeApp"[[:space:]]*:[[:space:]]*false/, "\"enableHomeApp\" : true"); print }
    ' "$settings" > "$tmp"
    chmod --reference="$settings" "$tmp"; mv -f "$tmp" "$settings"
fi

# SteamVR updates replace these upstream launch scripts. Insert idempotent
# hooks so the compatibility layer, GPU selection, and readiness gate survive.
if [[ -f "$compositor" ]] && ! grep -Fq 'PSVR2 Linux compatibility hooks' "$compositor"; then
    tmp=$(mktemp "${compositor}.XXXXXX")
    awk -v gpu="$AMD_VULKAN_DEVICE" '
      /^export SDL_VIDEODRIVER=x11$/ && !done {
        print; print ""; print "# PSVR2 Linux compatibility hooks"
        print "export VK_ADD_LAYER_PATH=\"$HOME/.local/share/psvr2-setup/steamvr-linux-fixes\""
        print "export VK_INSTANCE_LAYERS=VK_LAYER_BNUUY_steamvr_linux_fixes"
        if (gpu != "") {
          print "export MESA_VK_DEVICE_SELECT=\047" gpu "!\047"
          print "export MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE=1"
        }
        print "$HOME/.local/bin/psvr2-compositor-preflight"
        print "$HOME/.local/bin/psvr2-register-steam-library || true"
        done=1; next
      }
      { print }
      END { if (!done) exit 2 }
    ' "$compositor" > "$tmp"
    chmod --reference="$compositor" "$tmp"; mv -f "$tmp" "$compositor"
fi

if [[ -f "$vrstartup" ]] && ! grep -Fq 'PSVR2 persistent startup bridge' "$vrstartup"; then
    tmp=$(mktemp "${vrstartup}.XXXXXX")
    awk '/^set -u$/ && !done { print; print ""; print "# PSVR2 persistent startup bridge"; print "$HOME/.local/bin/psvr2-steamvr-bridge || true"; done=1; next } { print } END { if (!done) exit 2 }' \
        "$vrstartup" > "$tmp"
    chmod --reference="$vrstartup" "$tmp"; mv -f "$tmp" "$vrstartup"
fi

if [[ -f "$ignition" ]] && ! grep -Fq 'PSVR2_SETUP_ROOT' "$ignition"; then
    tmp=$(mktemp "${ignition}.XXXXXX")
    awk '/^unset SteamGameId$/ && !done { print; print ""; print "source \"$HOME/.local/lib/psvr2-linux/common.sh\""; print "export PROTONVERSION=\"Proton - Experimental\""; print "export PROTONPREFIX=\"$PSVR2_SETUP_ROOT/ignition-prefix\""; done=1; next } { print } END { if (!done) exit 2 }' \
        "$ignition" > "$tmp"
    chmod --reference="$ignition" "$tmp"; mv -f "$tmp" "$ignition"
fi

# WayVR is the default lower-overhead dashboard; make this reversible.
if [[ -f "$webhelper" ]]; then
    if [[ -f "$HOME/.config/psvr2-linux/use-valve-dashboard" ]]; then chmod a+x "$webhelper"; else chmod a-x "$webhelper"; fi
fi

# Fedora/Bazzite containers need host libraries visible to SteamVR tools.
if [[ -f "$vrenv" ]] && ! grep -Fq 'Fedora Monado host-library bridge' "$vrenv"; then
    tmp=$(mktemp "${vrenv}.XXXXXX")
    awk '/^export LD_LIBRARY_PATH=/ && !done { print; print ""; print "# Fedora Monado host-library bridge"; print "if [[ -d /run/host/usr/lib64 ]]; then"; print "\texport LD_LIBRARY_PATH=\"$LD_LIBRARY_PATH:/run/host/usr/lib64:/run/host/usr/lib64/pulseaudio\""; print "fi"; done=1; next } { print } END { if (!done) exit 2 }' \
        "$vrenv" > "$tmp"
    chmod --reference="$vrenv" "$tmp"; mv -f "$tmp" "$vrenv"
fi
