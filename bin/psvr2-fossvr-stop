#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh" >/dev/null 2>&1 || true
helper_dir="${PSVR2_HELPER_DIR:-$HOME/.local/bin}"
runtime_preflight="$helper_dir/psvr2-runtime-preflight"
audio_helper="$helper_dir/psvr2-audio"
controller_disconnect="$helper_dir/psvr2-controller-disconnect"
game_stop_helper="$helper_dir/psvr2-stop-games"
lock_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
runtime_artifacts=(
    "$lock_dir/wayvr.pid"
    "$lock_dir/wayvr.disp"
    "$lock_dir/monado_comp_ipc"
)

# A disconnect must preempt Room Setup before waiting for the shared lifecycle
# lock. Room Setup can hold that lock inside its nested runtime start while it
# waits for tracking that can no longer recover after USB/DP disappears.
if [[ "${PSVR2_AUTOMATED_STOP:-0}" == 1 ]]; then
    systemctl --user stop psvr2-room-setup.service 2>/dev/null || true
fi

exec 8>"$lock_dir/psvr2-fossvr-start.lock"
if ! flock -w "${PSVR2_STOP_LOCK_TIMEOUT_SECONDS:-10}" 8; then
    echo "PSVR2 lifecycle lock did not clear; forcing disconnect teardown" >&2
fi
if [[ "${PSVR2_AUTOMATED_STOP:-0}" != 1 ]]; then
    touch "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-autostart-suppressed"
fi
# End games before tearing down the compositor. This lets them release OpenXR,
# Vulkan, Wine, and Steam state cleanly; the helper escalates only PSVR2-owned
# launch process groups that ignore SIGTERM.
[[ ! -x "$game_stop_helper" ]] || "$game_stop_helper" || true
# A concurrent headset-link event may race this stop with a WayVR start. A
# canceled ancillary-unit job must never abort teardown before the compositor.
systemctl --user stop psvr2-fossvr-wayvr.service || true
systemctl --user stop psvr2-chaperone.service || true
systemctl --user stop psvr2-screenshot-listener.service || true
systemctl --user stop --no-block psvr2-fossvr.service
for _ in $(seq 1 20); do
    state=$(systemctl --user show psvr2-fossvr.service -p ActiveState --value)
    [[ "$state" == inactive || "$state" == failed ]] && break
    sleep 0.1
done
state=$(systemctl --user show psvr2-fossvr.service -p ActiveState --value)
if [[ "$state" != inactive && "$state" != failed ]]; then
    systemctl --user kill --kill-whom=all --signal=SIGKILL psvr2-fossvr.service || true
fi
systemctl --user stop psvr2-fossvr.service || true
# Release the Framework dGPU's forced VR profile on USB or DisplayPort
# disconnect. The USB-add udev event re-enables it on the next connection.
systemctl --no-block stop psvr2-dgpu-power.service 2>/dev/null || true
# Service shutdown can leave dead IPC and PID/display markers behind. Remove
# them only after every producer is stopped so the next connection cannot
# mistake stale state for a live compositor or dashboard.
for artifact in "${runtime_artifacts[@]}"; do
    if [[ -e "$artifact" || -S "$artifact" ]]; then
        unlink -- "$artifact" 2>/dev/null || true
    fi
done
systemctl --user reset-failed \
    psvr2-room-setup.service \
    psvr2-fossvr.service \
    psvr2-fossvr-wayvr.service \
    psvr2-chaperone.service \
    psvr2-screenshot-listener.service 2>/dev/null || true
if [[ "${PSVR2_DISCONNECT_CONTROLLERS:-0}" == "1" ]] && \
    [[ "${PSVR2_AUTOMATED_STOP:-0}" != "1" ]] && [[ -x "$controller_disconnect" ]]; then
    "$controller_disconnect" || true
fi
[[ ! -x "$runtime_preflight" ]] || "$runtime_preflight" || true
[[ ! -x "$audio_helper" ]] || "$audio_helper" restore || true
echo "PSVR2 runtime stopped."
