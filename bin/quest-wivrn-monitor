#!/usr/bin/bash
set -euo pipefail

quest_present() {
    local device
    for device in /sys/bus/usb/devices/*; do
        [[ -r "$device/idVendor" && -r "$device/idProduct" ]] || continue
        [[ "$(<"$device/idVendor")" == 2833 && "$(<"$device/idProduct")" == 5010 ]] && return 0
    done
    return 1
}

psvr2_present() {
    local device
    for device in /sys/bus/usb/devices/*; do
        [[ -r "$device/idVendor" && -r "$device/idProduct" ]] || continue
        [[ "$(<"$device/idVendor")" == 054c && "$(<"$device/idProduct")" == 0cde ]] && return 0
    done
    return 1
}

while true; do
    if quest_present && ! psvr2_present; then
        if ! systemctl --user is-active --quiet quest-wivrn-dashboard.service; then
            "$HOME/.local/bin/quest-wivrn-start" || true
        fi
    elif systemctl --user is-active --quiet quest-wivrn-dashboard.service; then
        "$HOME/.local/bin/quest-wivrn-stop" || true
    fi
    sleep 2
done
