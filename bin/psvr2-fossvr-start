#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

helper_dir="${PSVR2_HELPER_DIR:-$HOME/.local/bin}"
runtime_preflight="$helper_dir/psvr2-runtime-preflight"
chaperone_sanity="$helper_dir/psvr2-chaperone-sanity"
audio_helper="$helper_dir/psvr2-audio"
for helper in "$runtime_preflight" "$chaperone_sanity" "$audio_helper"; do
    if [[ ! -x "$helper" ]]; then
        echo "Required PSVR2 helper is missing or not executable: $helper" >&2
        exit 1
    fi
done

assert_monado_profile_supports_psvr2() {
    local profile_json="${XDG_CONFIG_HOME:-$HOME/.config}/envision/envision.json"
    local configured
    if [[ ! -r "$profile_json" ]]; then
        return 0
    fi
    configured=$(jq -r '.user_profiles[] | select(.uuid=="psvr2-toolkit-monado") | .xrservice_cmake_flags.XRT_BUILD_DRIVER_PSVR2 // ""' "$profile_json" 2>/dev/null || true)
    if [[ "$configured" == "OFF" || "$configured" == "" ]]; then
        echo "Envision profile currently disables PSVR2 runtime support (XRT_BUILD_DRIVER_PSVR2=$configured)." >&2
        echo "Run ./scripts/prepare-envision-runtime.sh to reapply the fixed profile, then Clean Build in Envision." >&2
        return 1
    fi
    return 0
}

assert_monado_binary_has_psvr2_builder() {
    local monado_binary="$MONADO_PREFIX/bin/monado-service"
    local found_builder=""
    if ! [[ -x "$monado_binary" ]]; then
        echo "Monado binary missing or non-executable: $monado_binary" >&2
        return 1
    fi
    if grep -aFq "t_builder_psvr2_create" "$monado_binary" 2>/dev/null; then
        found_builder=1
    fi
    if [[ "$found_builder" != "1" ]]; then
        echo "Monado was built without the PSVR2 driver (XRT_BUILD_DRIVER_PSVR2 is OFF)." >&2
        echo "Re-run ./scripts/prepare-envision-runtime.sh and perform a Clean Build in Envision." >&2
        return 1
    fi
    return 0
}

lock_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec 8>"$lock_dir/psvr2-fossvr-start.lock"
flock 8
systemctl --user start psvr2-autostart-monitor.service || true

socket="$lock_dir/monado_comp_ipc"
if systemctl --user is-active --quiet psvr2-fossvr.service \
    && [[ -S "$socket" ]] && ss -H -xl | grep -Fq "$socket"; then
    systemctl --user start psvr2-fossvr-wayvr.service
    "$audio_helper" vr || true
    echo "PSVR2 already ready: ${PSVR2_REFRESH_RATE} Hz / ${PSVR2_RENDER_SCALE}% + WayVR."
    exit 0
fi

# Steam's pressure-vessel container can provide an objdump that cannot inspect
# the host-built Monado binary.  Only run build/profile validation when a new
# runtime is actually needed, and use a byte-string check that works both on
# the host and from Steam launch containers.
"$helper_dir/psvr2-sync-steam-vr-games" --discovery-only || true
assert_monado_profile_supports_psvr2
assert_monado_binary_has_psvr2_builder

rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-autostart-suppressed"

"$chaperone_sanity" || true

systemctl --user stop monado.socket monado.service 2>/dev/null || true
"$runtime_preflight"
if systemctl --user is-active --quiet psvr2-fossvr.service; then
    echo "Refusing to replace the Monado socket while the PSVR2 service is still active" >&2
    exit 1
fi
systemctl --user reset-failed psvr2-fossvr.service psvr2-fossvr-wayvr.service 2>/dev/null || true

[[ ! -S "$socket" ]] || unlink "$socket"
systemctl --user start psvr2-fossvr.service
service_pid=$(systemctl --user show psvr2-fossvr.service -p MainPID --value)

for _ in $(seq 1 100); do
    [[ -S "$socket" ]] && ss -H -xl | grep -Fq "$socket" && break
    if ! systemctl --user is-active --quiet psvr2-fossvr.service; then
        journalctl --user -u psvr2-fossvr.service -n 60 --no-pager >&2
        exit 1
    fi
    sleep 0.1
done
[[ -S "$socket" ]] && ss -H -xl | grep -Fq "$socket" || { echo "Monado IPC socket was not created" >&2; exit 1; }

is_monado_hmd_ready() {
    local pid=$1
    local logs
    logs=$(journalctl --user -u psvr2-fossvr.service "_PID=$pid" -o cat --no-pager 2>/dev/null || true)

    # Successful start signs: explicit headset enumeration and selected-system
    # success. These strings are stable across recent Monado log formats.
    if grep -Fq "Got devices:" <<<"$logs" && grep -Fq "Result: XRT_SUCCESS" <<<"$logs"; then
        if grep -Fq "PS VR2 HMD" <<<"$logs"; then
            return 0
        fi
    fi

    if grep -Fq "head: PS VR2 HMD" <<<"$logs"; then
        return 0
    fi

    return 1
}

is_monado_failed() {
    local pid=$1
    local logs
    logs=$(journalctl --user -u psvr2-fossvr.service "_PID=$pid" -o cat --no-pager 2>/dev/null || true)

    if grep -Eq "XRT_ERROR_DEVICE_CREATION_FAILED|Unable to find HMD|PSVR2 HMD device creation failed|Could not allocate" <<<"$logs"; then
        return 0
    fi

    # "No builder selected in config" is normal while probing until a backend wins.
    # Only treat it as failure when a final selected backend is missing.
    if grep -Fq "No builder selected in config" <<<"$logs" && ! grep -Fq "Selected psvr2 because" <<<"$logs"; then
        return 0
    fi
    return 1
}

# A live IPC socket only proves monado-service started. The proprietary
# PSVR2 driver can remain alive after USB initialization fails, leaving a
# headless runtime that systemd incorrectly reports as healthy. Do not probe
# Monado while Sony's driver is still claiming its USB interfaces: concurrent
# probing can race that initialization. Wait for the service process to report
# the fully-created HMD; WayVR starting successfully below is the IPC check.
runtime_healthy=0
for _ in $(seq 1 80); do
    if is_monado_hmd_ready "$service_pid"; then
        runtime_healthy=1
        break
    fi

    if is_monado_failed "$service_pid"; then
        echo "Monado startup reached a runtime creation failure" >&2
        journalctl --user -u psvr2-fossvr.service -n 120 --no-pager >&2
        systemctl --user stop psvr2-fossvr.service || true
        exit 1
    fi

    systemctl --user is-active --quiet psvr2-fossvr.service || break
    sleep 0.25
done
if (( ! runtime_healthy )); then
    echo "Monado started but did not create the PSVR2 device" >&2
    journalctl --user -u psvr2-fossvr.service -n 80 --no-pager >&2
    systemctl --user stop psvr2-fossvr.service || true
    exit 1
fi

systemctl --user start psvr2-fossvr-wayvr.service
sleep 1
systemctl --user is-active --quiet psvr2-fossvr-wayvr.service || {
    journalctl --user -u psvr2-fossvr-wayvr.service -n 60 --no-pager >&2; exit 1;
}
if [[ "${PSVR2_CHAPERONE_ENABLE:-0}" == 1 ]]; then
    if [[ -x "${PSVR2_CHAPERONE_BINARY}" ]]; then
        systemctl --user start psvr2-chaperone.service || true
    else
        echo "PSVR2 chaperone is enabled but the AppImage is missing at ${PSVR2_CHAPERONE_BINARY}; run ./scripts/fetch-community-tools.sh"
    fi
fi
"$audio_helper" vr || true
echo "PSVR2 ready: ${PSVR2_REFRESH_RATE} Hz / ${PSVR2_RENDER_SCALE}% + WayVR."
