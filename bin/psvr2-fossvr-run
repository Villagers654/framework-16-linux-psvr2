#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"
[[ $# -gt 0 ]] || { echo "Usage: psvr2-fossvr-run PROGRAM [ARG ...]" >&2; exit 2; }

# Never inherit one-off calibration flags into normal games, while allowing the
# dedicated Room Setup wrapper to pass them deliberately.
if [[ "${PSVR2_ROOM_SETUP_LAUNCH:-0}" != 1 ]]; then
    unset XRIZER_FORCE_RAW_TRACKING_SPACE XRIZER_RAW_CHAPERONE_PATH XRIZER_FORCE_HEADSET_ON_HEAD || true
fi
unset PSVR2_ROOM_SETUP_LAUNCH || true

start_helper="${PSVR2_HELPER_DIR:-$HOME/.local/bin}/psvr2-fossvr-start"
[[ -x "$start_helper" ]] || { echo "Required PSVR2 helper is missing or not executable: $start_helper" >&2; exit 1; }

if ! systemctl --user is-active --quiet psvr2-fossvr.service ||
   ! systemctl --user is-active --quiet psvr2-fossvr-wayvr.service; then
    "$start_helper"
fi

socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/monado_comp_ipc"
game_registry_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-games"
game_registration=""
game_scope="psvr2-game-$BASHPID.scope"
if [[ ! -S "$socket" ]] || ! ss -H -xl | grep -Fq "$socket"; then
    echo "Monado is active but its IPC socket is unavailable; repairing the runtime" >&2
    "$start_helper"
fi
if [[ ! -S "$socket" ]] || ! ss -H -xl | grep -Fq "$socket"; then
    echo "Monado IPC socket is unavailable: $socket" >&2
    exit 1
fi

export XR_RUNTIME_JSON="$MONADO_PREFIX/share/openxr/1/openxr_monado.json"
export VR_OVERRIDE="$ENVISION_PROFILE_ROOT/xrizer/target/release"
export PRESSURE_VESSEL_IMPORT_OPENXR_1_RUNTIMES=1
export OXR_ZERO_TIME_IS_NOW=1
# Present parallel application views on canted-display headsets such as PSVR2.
# Some engines build their projection or UI culling around parallel cameras;
# Monado applies the physical cant again in the compositor.  This Monado-only
# compatibility switch is inert on parallel headsets and avoids per-title
# launch exceptions for affected OpenXR and translated OpenVR applications.
export OXR_PARALLEL_VIEWS=1
export PRESSURE_VESSEL_FILESYSTEMS_RW="$socket${PRESSURE_VESSEL_FILESYSTEMS_RW:+:$PRESSURE_VESSEL_FILESYSTEMS_RW}"
# Keep every game-side Vulkan/DXVK device on the same dGPU as Monado. Hybrid
# systems otherwise let secondary DLLs select the iGPU, which deadlocks shared
# VR textures even when the game's primary D3D device picked the dGPU.
if [[ -n "$AMD_VULKAN_DEVICE" ]]; then
    export MESA_VK_DEVICE_SELECT="${AMD_VULKAN_DEVICE}!"
    export MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE=1
    export AMD_VULKAN_DEVICE
fi
if [[ -n "$DGPU_PCI_ADDRESS" ]]; then
    export DRI_PRIME="pci-${DGPU_PCI_ADDRESS//:/_}"
    export DRI_PRIME="${DRI_PRIME//./_}"
fi
# VR frame pacing comes from OpenXR's wait-frame path. Never let a game's
# optional desktop mirror add a second, laptop-display vblank deadline.
export vblank_mode=0
export MESA_VK_WSI_PRESENT_MODE=immediate

game_pid=""
runtime_watcher=""
forward_signal() {
    [[ -n "$game_pid" ]] && kill -TERM -- "-$game_pid" 2>/dev/null || true
    systemctl --user stop --no-block "$game_scope" 2>/dev/null || true
}
cleanup() {
    if [[ -n "$runtime_watcher" ]]; then
        kill "$runtime_watcher" 2>/dev/null || true
        wait "$runtime_watcher" 2>/dev/null || true
    fi
    [[ -z "$game_registration" ]] || rm -f -- "$game_registration"
    if systemctl --user is-active --quiet psvr2-fossvr.service &&
       ! systemctl --user is-active --quiet psvr2-fossvr-wayvr.service; then
        systemctl --user start psvr2-fossvr-wayvr.service || true
    fi
}
trap forward_signal HUP INT TERM
trap cleanup EXIT

# Put each Steam launch in its own process group. If a Proton/Wine child
# outlives the launcher or the headset disappears, the whole title exits and
# cannot keep consuming the GPU underneath the restored WayVR dashboard.
# A process group handles ordinary native games. The transient systemd scope is
# the stronger ownership boundary for Proton/Revive: Wine may reparent or move
# an injected game to another process group, but every descendant remains in
# this cgroup until the title exits.
setsid systemd-run --user --scope --unit="${game_scope%.scope}" --collect --quiet -- "$@" &
game_pid=$!
install -d -m 0700 "$game_registry_dir"
game_registration="$game_registry_dir/$BASHPID"
registration_tmp="$game_registration.tmp"
printf '%s %s %s\n' "$game_pid" "$(< /proc/sys/kernel/random/boot_id)" "$game_scope" > "$registration_tmp"
chmod 0600 "$registration_tmp"
mv -f -- "$registration_tmp" "$game_registration"

# If the headset monitor stops Monado because either cable disappears, end the
# wrapped VR title as well instead of leaving Proton/Steam showing it as
# running without a headset.
(
    # Revive and several launchers inject into a child, then let their original
    # process exit. The child remains in the setsid process group, so monitor
    # the group rather than only its short-lived leader.
    while kill -0 -- "-$game_pid" 2>/dev/null; do
        if ! systemctl --user is-active --quiet psvr2-fossvr.service; then
            kill -TERM -- "-$game_pid" 2>/dev/null || true
            systemctl --user stop --no-block "$game_scope" 2>/dev/null || true
            exit 0
        fi
        sleep 1
    done
) &
runtime_watcher=$!

set +e
wait "$game_pid"
game_status=$?
set -e

# Do not restore WayVR while a detached/injected game is still alive. Wine
# reparents those processes to the user manager, but it preserves the launch
# session's process group, which gives us a runtime-agnostic ownership handle.
while kill -0 -- "-$game_pid" 2>/dev/null || \
    systemctl --user is-active --quiet "$game_scope"; do
    sleep 0.25
done
exit "$game_status"
