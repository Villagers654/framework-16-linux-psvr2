#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"
state="$HOME/.config/psvr2-linux/use-valve-dashboard"
helper="$STEAM_ROOT/steamapps/common/SteamVR/bin/vrwebhelper/linux64/vrwebhelper"
case "${1:-status}" in
    wayvr) rm -f "$state"; [[ ! -f "$helper" ]] || chmod a-x "$helper"; echo wayvr ;;
    steamvr) touch "$state"; [[ ! -f "$helper" ]] || chmod a+x "$helper"; echo steamvr ;;
    status) [[ -f "$state" ]] && echo steamvr || echo wayvr ;;
    *) echo "Usage: psvr2-dashboard-mode {wayvr|steamvr|status}" >&2; exit 2 ;;
esac
