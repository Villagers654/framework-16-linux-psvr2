#!/usr/bin/bash
set -u
for _ in $(seq 1 50); do
    guard=false; connector=false
    systemctl is-active --quiet psvr2-dgpu-power.service 2>/dev/null && guard=true
    for status in /sys/class/drm/card*-DP-*/status; do
        [[ -r "$status" && $(cat "$status" 2>/dev/null) == connected ]] && connector=true
    done
    $guard && $connector && break
    sleep 0.1
done
sleep 4
