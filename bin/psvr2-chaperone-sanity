#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

chaperone_file="${1:-$STEAM_ROOT/config/playstation_vr2/chaperone_info.vrchap}"

if [[ ! -f "$chaperone_file" ]]; then
    exit 0
fi

# Some firmware/driver edge cases persist a clearly invalid standing translation
# (commonly a tall Y offset) into SteamVR's calibration file. That can make the
# HMD start above/below the expected floor until a reset. Keep the standing
# transform bounded so the room-space origin remains sane while preserving your
# measured boundary geometry.
python3 - "$chaperone_file" <<'PY'
import json
import math
import pathlib
import shutil
import sys
import time

path = pathlib.Path(sys.argv[1])
max_y = 0.65
max_axis = 3.0

try:
    with path.open("r", encoding="utf-8") as f:
        data = json.load(f)
except json.JSONDecodeError as exc:
    print(f"PSVR2 chaperone sanity: failed to parse {path}: {exc}", file=sys.stderr)
    raise SystemExit(1)
except OSError as exc:
    print(f"PSVR2 chaperone sanity: failed to read {path}: {exc}", file=sys.stderr)
    raise SystemExit(1)

universes = data.get("universes")
if not isinstance(universes, list):
    print(f"PSVR2 chaperone sanity: {path} is missing/invalid universes")
    raise SystemExit(0)

changed = False

for i, universe in enumerate(universes):
    if not isinstance(universe, dict):
        continue

    standing = universe.get("standing")
    if not isinstance(standing, dict):
        continue

    translation = standing.get("translation")
    if (not isinstance(translation, list)) or len(translation) < 3:
        continue

    sanitized = []
    for axis, value in enumerate(translation[:3]):
        if not isinstance(value, (int, float)) or not math.isfinite(float(value)):
            sanitized.append(0.0)
        elif axis == 1:
            sanitized.append(0.0 if abs(float(value)) > max_y else float(value))
        else:
            sanitized.append(0.0 if abs(float(value)) > max_axis else float(value))

    normalized = [float(v) for v in translation[:3]]
    if sanitized != normalized:
        print(
            f"PSVR2 chaperone sanity: clamping standing.translation for universe {i}: "
            f"{normalized} -> {sanitized}"
        )
        standing["translation"] = sanitized
        changed = True

if changed:
    backup = path.with_suffix(path.suffix + f".bak.{int(time.time())}")
    shutil.copy2(path, backup)
    with path.open("w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    print(f"PSVR2 chaperone sanity: wrote corrected chaperone file; backup at {backup}")

raise SystemExit(0)
PY
