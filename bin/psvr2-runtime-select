#!/usr/bin/bash
set -euo pipefail

mode=${1:-}
manifest=${2:-${MONADO_PREFIX:-$HOME/.local/share/envision/prefixes/psvr2-toolkit-monado}/share/openxr/1/openxr_monado.json}
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
runtime_dir="$config_home/openxr/1"
active="$runtime_dir/active_runtime.json"
backup="$runtime_dir/active_runtime.json.psvr2-backup"
lock_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

mkdir -p "$runtime_dir"
exec 9>"$lock_dir/psvr2-runtime-select.lock"
flock 9

points_to_manifest() {
    [[ -L "$active" ]] && [[ "$(readlink -f -- "$active" 2>/dev/null || true)" == "$(readlink -f -- "$manifest" 2>/dev/null || true)" ]]
}

case "$mode" in
    acquire)
        [[ -r "$manifest" ]] || { echo "OpenXR runtime manifest is missing: $manifest" >&2; exit 1; }
        points_to_manifest && exit 0
        [[ ! -e "$backup" && ! -L "$backup" ]] || {
            echo "Refusing to overwrite an unrestored PSVR2 runtime backup: $backup" >&2
            exit 1
        }
        if [[ -e "$active" || -L "$active" ]]; then
            mv -- "$active" "$backup"
        fi
        ln -s -- "$manifest" "$active"
        ;;
    release)
        if points_to_manifest; then
            unlink -- "$active"
            if [[ -e "$backup" || -L "$backup" ]]; then
                mv -- "$backup" "$active"
            fi
        fi
        ;;
    status)
        if points_to_manifest; then
            echo psvr2
        elif [[ -e "$active" || -L "$active" ]]; then
            readlink -f -- "$active" 2>/dev/null || printf '%s\n' "$active"
        else
            echo none
        fi
        ;;
    *)
        echo "Usage: psvr2-runtime-select acquire|release|status [manifest]" >&2
        exit 2
        ;;
esac
