#!/usr/bin/python3
"""Persist the Monado wrapper for installed Steam VR titles."""

from __future__ import annotations
import argparse
import json
import os
import re
import stat
import sys
import tempfile
import subprocess
from pathlib import Path
import urllib.request

HOME = Path.home()
CONFIG = HOME / ".config/psvr2-linux/settings.env"
STEAM = HOME / ".local/share/Steam"
if CONFIG.exists():
    match = re.search(r'^STEAM_ROOT="?([^"\n]+)', CONFIG.read_text(), re.M)
    if match:
        STEAM = Path(os.path.expandvars(match.group(1))).expanduser()
STATE = HOME / ".local/share/psvr2-setup/steam-vr-apps.json"
VR_MANIFEST = STEAM / "config/steamapps.vrmanifest"
WRAPPER = str(HOME / ".local/bin/psvr2-fossvr-run")
FORCE_VR_IDS = ""
MANAGE_LAUNCH_OPTIONS = True
if CONFIG.exists():
    text = CONFIG.read_text()
    match = re.search(r'^PSVR2_FORCE_VR_IDS="?([^"\n]+)', text, re.M)
    if match:
        FORCE_VR_IDS = match.group(1)
    match = re.search(r'^PSVR2_MANAGE_STEAM_LAUNCH_OPTIONS="?([01])', text, re.M)
    if match:
        MANAGE_LAUNCH_OPTIONS = match.group(1) == "1"

# Hybrid games known to require an explicit VR mode. Add new entries here.
VR_FLAGS = {
    "1222730": "-vr",                       # STAR WARS: Squadrons
    "732690": "-vr",                       # Five Nights at Freddy's: Help Wanted
}

# Some games advertise Linux support but omit VR from their native Linux depot.
# Force their Windows build so Steam's /vr launch action reaches xrizer.
FORCE_PROTON = {
    "341800": "proton_experimental",       # Keep Talking and Nobody Explodes
}
KNOWN = {appid: True for appid in set(VR_FLAGS) | set(FORCE_PROTON)}
NON_GAME_IDS = {
    "250820",   # SteamVR
    "2580190",  # PlayStation VR2 App
    "1493710",  # Proton Experimental
    "1070560", "1391110", "1628350", "4183110",  # Steam Linux runtimes
    "228980", "1826330", "2805730",  # redistributables and compatibility tools
}

KTANE_SETTINGS = (
    STEAM / "steamapps/compatdata/341800/pfx/drive_c/users/steamuser/AppData/LocalLow"
    / "Steel Crate Games/Keep Talking and Nobody Explodes/playerSettings.xml"
)

def steam_running() -> bool:
    for comm in Path("/proc").glob("[0-9]*/comm"):
        try:
            if comm.read_text().strip() == "steam": return True
        except (OSError, PermissionError): pass
    return False

def installed_apps() -> dict[str, str]:
    def parse_root(root: Path) -> dict[str, str]:
        apps = {}
        for manifest in root.glob("appmanifest_*.acf"):
            text = manifest.read_text(errors="replace")
            appid = re.search(r'^\s*"appid"\s+"(\d+)"', text, re.M)
            name = re.search(r'^\s*"name"\s+"([^"]+)"', text, re.M)
            if appid: apps[appid.group(1)] = name.group(1) if name else appid.group(1)
        return apps

    apps: dict[str, str] = {}
    roots = {STEAM / "steamapps"}
    library_file = STEAM / "config/libraryfolders.vdf"
    if library_file.exists():
        for match in re.finditer(r'"path"\s+"([^"]+)"', library_file.read_text(errors="replace")):
            raw_path = os.path.expandvars(match.group(1))
            normalized = raw_path.replace("\\\\", "/").replace("\\", "/")
            root = Path(os.path.expanduser(normalized))
            if (root / "steamapps").exists():
                roots.add(root / "steamapps")
    for root in sorted(roots):
        apps.update(parse_root(root))
    return apps

def registered_vr_apps(installed: dict[str, str]) -> dict[str, str]:
    """Return Steam and non-Steam VR entries that are currently launchable."""
    try:
        payload = json.loads(VR_MANIFEST.read_text(errors="strict"))
    except (FileNotFoundError, UnicodeDecodeError, json.JSONDecodeError):
        return {}

    result: dict[str, str] = {}
    for entry in payload.get("applications", []):
        if not isinstance(entry, dict):
            continue
        match = re.fullmatch(r"steam[.]app[.](\d+)", str(entry.get("app_key", "")))
        if not match:
            continue
        appid = match.group(1)
        strings = entry.get("strings", {})
        localized = strings.get("en_us", {}) if isinstance(strings, dict) else {}
        name = localized.get("name", installed.get(appid, appid)) if isinstance(localized, dict) else installed.get(appid, appid)

        # Normal Steam games remain authoritative through their appmanifest.
        # For non-Steam entries, require Steam's generated Linux launcher to
        # still exist so deleted shortcuts do not linger in WayVR.
        if appid not in installed:
            if entry.get("launch_type") != "binary":
                continue
            binary = Path(os.path.expandvars(str(entry.get("binary_path_linux", "")))).expanduser()
            if not binary.is_file():
                continue
        result[appid] = str(name)
    return result

def store_says_vr(appid: str) -> bool:
    url = f"https://store.steampowered.com/api/appdetails?appids={appid}&cc=us&l=english"
    request = urllib.request.Request(url, headers={"User-Agent": "PSVR2-Steam-sync/1"})
    with urllib.request.urlopen(request, timeout=4) as response:
        record = json.load(response).get(appid, {})
    data = record.get("data", {}) if record.get("success") else {}
    descriptions = [str(x.get("description", "")).lower() for x in data.get("categories", [])]
    return any("vr only" in x or "vr supported" in x or "vr support" in x for x in descriptions)

def desired_launch(appid: str) -> str:
    suffix = VR_FLAGS.get(appid, "")
    return f"{WRAPPER} %command%" + (f" {suffix}" if suffix else "")

def block_bounds(text: str, header: re.Match[str]) -> tuple[int, int]:
    start = header.end(); depth = 1; length = 0
    for line in text[start:].splitlines(keepends=True):
        depth += line.count("{") - line.count("}"); length += len(line)
        if depth == 0: break
    return start, start + length

def patch_localconfig(path: Path, vr_appids: set[str]) -> bool:
    original = path.read_text(errors="strict"); text = original
    for appid in sorted(vr_appids, key=int):
        header = re.search(rf'(?m)^\t{{5}}"{re.escape(appid)}"[ \t]*\n\t{{5}}\{{[ \t]*$', text)
        if not header: continue
        block_start, block_end = block_bounds(text, header)
        block = text[block_start:block_end]
        wanted = desired_launch(appid)
        option = re.search(r'(?m)^\t{6}"LaunchOptions"\s+"([^"]*)"\s*$', block)
        if option:
            current = option.group(1)
            if WRAPPER in current: replacement = wanted
            elif "%command%" in current:
                replacement = current.replace("%command%", f"{WRAPPER} %command%", 1)
                if VR_FLAGS.get(appid) and VR_FLAGS[appid] not in replacement: replacement += " " + VR_FLAGS[appid]
            else: replacement = wanted + (" " + current if current else "")
            block = block[:option.start(1)] + replacement + block[option.end(1):]
        else:
            block = f'\n\t\t\t\t\t\t"LaunchOptions"\t\t"{wanted}"' + block
        text = text[:block_start] + block + text[block_end:]
    if text == original: return False
    backup = path.with_name(path.name + ".psvr2-auto-backup")
    if not backup.exists(): backup.write_text(original)
    mode = stat.S_IMODE(path.stat().st_mode)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as output:
        output.write(text); temporary = Path(output.name)
    temporary.chmod(mode); os.replace(temporary, path); return True

def patch_compat_tools(path: Path) -> bool:
    original = path.read_text(errors="strict"); text = original
    section = re.search(r'(?m)^\t{4}"CompatToolMapping"[ \t]*\n\t{4}\{[ \t]*$', text)
    if not section:
        print(f"PSVR2: CompatToolMapping section not found in {path}", file=sys.stderr)
        return False
    section_start, section_end = block_bounds(text, section)
    block = text[section_start:section_end]
    for appid, tool in FORCE_PROTON.items():
        wanted = (
            f'\t\t\t\t\t"{appid}"\n'
            '\t\t\t\t\t{\n'
            f'\t\t\t\t\t\t"name"\t\t"{tool}"\n'
            '\t\t\t\t\t\t"config"\t\t""\n'
            '\t\t\t\t\t\t"priority"\t\t"250"\n'
            '\t\t\t\t\t}\n'
        )
        entry = re.search(rf'(?m)^\t{{5}}"{re.escape(appid)}"[ \t]*\n\t{{5}}\{{[ \t]*$', block)
        if entry:
            entry_start = entry.start()
            _, entry_end = block_bounds(block, entry)
            block = block[:entry_start] + wanted + block[entry_end:]
        else:
            closing = block.rfind("\t\t\t\t}")
            if closing < 0: continue
            block = block[:closing] + wanted + block[closing:]
    text = text[:section_start] + block + text[section_end:]
    if text == original: return False
    backup = path.with_name(path.name + ".psvr2-auto-backup")
    if not backup.exists(): backup.write_text(original)
    mode = stat.S_IMODE(path.stat().st_mode)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as output:
        output.write(text); temporary = Path(output.name)
    temporary.chmod(mode); os.replace(temporary, path); return True

def patch_ktane_settings(path: Path) -> bool:
    """Avoid pacing KTaNE's 120 Hz VR output against its desktop mirror."""
    if not path.exists(): return False
    original = path.read_text(errors="strict")
    text = original.replace("<VSync>1</VSync>", "<VSync>0</VSync>")
    # Full 170% PSVR2 resolution plus legacy Unity MSAA saturates the RX 7600
    # path. The 1.7x eye target already supersamples edges, so disable the
    # redundant pass without changing the 3400x3468 render target.
    text = re.sub(r"<AntiAliasing>[24]</AntiAliasing>", "<AntiAliasing>0</AntiAliasing>", text)
    if text == original: return False
    mode = stat.S_IMODE(path.stat().st_mode)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as output:
        output.write(text); temporary = Path(output.name)
    temporary.chmod(mode); os.replace(temporary, path); return True


def restart_wayvr_dashboard() -> None:
    if os.environ.get("PSVR2_SYNC_RESTART_DASHBOARD", "1") == "0":
        print("PSVR2: PSVR2_SYNC_RESTART_DASHBOARD is disabled; skipping WayVR restart.")
        return

    cmd = ["systemctl", "--user", "is-active", "--quiet", "psvr2-fossvr-wayvr.service"]
    if subprocess.run(cmd, capture_output=True, text=True).returncode != 0:
        return

    restart = ["systemctl", "--user", "restart", "psvr2-fossvr-wayvr.service"]
    proc = subprocess.run(restart, capture_output=True, text=True)
    if proc.returncode != 0:
        print(
            "PSVR2: Failed to restart WayVR dashboard after cache refresh:"
            f" {proc.stderr.strip() or proc.stdout.strip()}"
        )

def main() -> int:
    parser = argparse.ArgumentParser(description="Sync Steam VR launch metadata for WayVR.")
    parser.add_argument("--discovery-only", action="store_true", help="Only refresh the WayVR cache.")
    parser.add_argument("--force", action="store_true", help="Allow launch-option patching while Steam is running.")
    parser.add_argument(
        "--refresh-metadata",
        action="store_true",
        help="Re-query Steam metadata for cached non-VR applications.",
    )
    parser.add_argument(
        "--no-restart-dashboard",
        action="store_true",
        help="Skip restarting WayVR after refresh (for systems where restart is managed externally).",
    )
    args = parser.parse_args()

    apps = installed_apps()
    registered_vr = registered_vr_apps(apps)
    apps.update({appid: name for appid, name in registered_vr.items() if appid not in apps})
    cache = dict(KNOWN)
    try:
        saved = json.loads(STATE.read_text())
        if isinstance(saved, dict):
            cache.update({str(key): value for key, value in saved.items() if isinstance(value, bool)})
    except (FileNotFoundError, json.JSONDecodeError):
        pass

    # Steam's VR manifest is definitive for both native Steam VR titles and
    # explicitly registered non-Steam launchers such as Revive games.
    for appid in registered_vr:
        cache[appid] = True

    # Query new manifests once. Re-query cached negatives only when explicitly
    # requested; normal startup must not depend on dozens of network requests.
    for appid in apps:
        if appid in NON_GAME_IDS:
            cache[appid] = False
            continue
        if appid in cache and not args.refresh_metadata:
            continue

        try:
            cache[appid] = store_says_vr(appid)
        except Exception:
            # Preserve explicit positive/negative states when API calls fail.
            if appid not in cache:
                cache[appid] = False

    # Keep cache entries only for currently-installed applications (plus known
    # helper entries) so stale IDs don't linger and accidentally block future
    # lookups after app uninstalls.
    installed_set = set(apps)
    for cached_appid in list(cache.keys()):
        if cached_appid in KNOWN:
            continue
        if cached_appid not in installed_set:
            cache.pop(cached_appid, None)

    # Optional environment variable or settings.env override for manual cases where
    # Steam API metadata is temporarily incomplete. Add app IDs with
    # comma-separated values.
    extra_ids = os.environ.get("PSVR2_FORCE_VR_IDS", FORCE_VR_IDS)
    for appid in (value.strip() for value in extra_ids.split(",") if value.strip()):
        if appid.isdecimal():
            cache[appid] = True
        else:
            print(f"PSVR2: ignoring invalid forced Steam app ID: {appid!r}", file=sys.stderr)

    # Persist a deterministic cache for WayVR so startup behavior does not depend
    # on how long Steam has had to settle after installation or launch.
    payload = json.dumps(cache, indent=2, sort_keys=True) + "\n"
    previous_payload = STATE.read_text(errors="replace") if STATE.exists() else ""
    state_changed = payload != previous_payload
    if state_changed:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile("w", dir=STATE.parent, delete=False) as output:
            output.write(payload)
            temporary = Path(output.name)
        temporary.chmod(0o644)
        os.replace(temporary, STATE)

    print(f"PSVR2: synced {len(cache)} steam ids, {sum(1 for v in cache.values() if v)} vr-enabled")

    patch_launch_options = (
        MANAGE_LAUNCH_OPTIONS
        and not args.discovery_only
        and (args.force or not steam_running())
    )
    vr = {appid for appid in apps if cache.get(appid) is True}
    if patch_launch_options:
        for config in (STEAM / "userdata").glob("[0-9]*/config/localconfig.vdf"):
            patch_localconfig(config, vr)
        steam_config = STEAM / "config/config.vdf"
        if steam_config.exists(): patch_compat_tools(steam_config)
    elif args.discovery_only:
        print("PSVR2: discovery-only mode; launch options were not changed.")
    elif not MANAGE_LAUNCH_OPTIONS:
        print("PSVR2: launch-option management is disabled in settings.env.")
    else:
        print("PSVR2: Steam is running; launch options were not changed (use --force to override).")

    if state_changed and not args.no_restart_dashboard:
        restart_wayvr_dashboard()
    patch_ktane_settings(KTANE_SETTINGS)
    return 0

if __name__ == "__main__": sys.exit(main())
