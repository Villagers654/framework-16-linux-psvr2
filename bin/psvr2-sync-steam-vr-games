#!/usr/bin/python3
"""Persist the Monado wrapper for installed Steam VR titles."""

from __future__ import annotations
import json, os, re, stat, sys, tempfile, urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config/psvr2-linux/settings.env"
STEAM = HOME / ".local/share/Steam"
if CONFIG.exists():
    match = re.search(r'^STEAM_ROOT="?([^"\n]+)', CONFIG.read_text(), re.M)
    if match:
        STEAM = Path(os.path.expandvars(match.group(1))).expanduser()
STATE = HOME / ".local/share/psvr2-setup/steam-vr-apps.json"
WRAPPER = str(HOME / ".local/bin/psvr2-fossvr-run")

# Hybrid games known to require an explicit VR mode. Add new entries here.
VR_FLAGS = {
    "1222730": "-vr",                       # STAR WARS: Squadrons
    "341800": "-steamvr -vrmode openvr",   # Keep Talking and Nobody Explodes
    "732690": "-vr",                       # Five Nights at Freddy's: Help Wanted
}
KNOWN = {appid: True for appid in VR_FLAGS}

def steam_running() -> bool:
    for comm in Path("/proc").glob("[0-9]*/comm"):
        try:
            if comm.read_text().strip() == "steam": return True
        except (OSError, PermissionError): pass
    return False

def installed_apps() -> dict[str, str]:
    apps = {}
    for manifest in STEAM.glob("steamapps/appmanifest_*.acf"):
        text = manifest.read_text(errors="replace")
        appid = re.search(r'^\s*"appid"\s+"(\d+)"', text, re.M)
        name = re.search(r'^\s*"name"\s+"([^"]+)"', text, re.M)
        if appid: apps[appid.group(1)] = name.group(1) if name else appid.group(1)
    return apps

def store_says_vr(appid: str) -> bool:
    url = f"https://store.steampowered.com/api/appdetails?appids={appid}&cc=us&l=english"
    request = urllib.request.Request(url, headers={"User-Agent": "PSVR2-Steam-sync/1"})
    with urllib.request.urlopen(request, timeout=4) as response:
        record = json.load(response).get(appid, {})
    data = record.get("data", {}) if record.get("success") else {}
    descriptions = [str(x.get("description", "")).lower() for x in data.get("categories", [])]
    return any("vr only" in x or "vr supported" in x or "vr support" in x for x in descriptions)

def desired_launch(appid: str) -> str:
    suffix = VR_FLAGS.get(appid, "")
    return f"{WRAPPER} %command%" + (f" {suffix}" if suffix else "")

def patch_localconfig(path: Path, vr_appids: set[str]) -> bool:
    original = path.read_text(errors="strict"); text = original
    for appid in sorted(vr_appids, key=int):
        header = re.search(rf'(?m)^\t{{5}}"{re.escape(appid)}"[ \t]*\n\t{{5}}\{{[ \t]*$', text)
        if not header: continue
        block_start = header.end(); depth = 1; block_len = 0
        for line in text[block_start:].splitlines(keepends=True):
            depth += line.count("{") - line.count("}"); block_len += len(line)
            if depth == 0: break
        block_end = block_start + block_len; block = text[block_start:block_end]
        wanted = desired_launch(appid)
        option = re.search(r'(?m)^\t{6}"LaunchOptions"\s+"([^"]*)"\s*$', block)
        if option:
            current = option.group(1)
            if WRAPPER in current: replacement = wanted
            elif "%command%" in current:
                replacement = current.replace("%command%", f"{WRAPPER} %command%", 1)
                if VR_FLAGS.get(appid) and VR_FLAGS[appid] not in replacement: replacement += " " + VR_FLAGS[appid]
            else: replacement = wanted + (" " + current if current else "")
            block = block[:option.start(1)] + replacement + block[option.end(1):]
        else:
            block = f'\n\t\t\t\t\t\t"LaunchOptions"\t\t"{wanted}"' + block
        text = text[:block_start] + block + text[block_end:]
    if text == original: return False
    backup = path.with_name(path.name + ".psvr2-auto-backup")
    if not backup.exists(): backup.write_text(original)
    mode = stat.S_IMODE(path.stat().st_mode)
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as output:
        output.write(text); temporary = Path(output.name)
    temporary.chmod(mode); os.replace(temporary, path); return True

def main() -> int:
    if steam_running(): return 0
    apps = installed_apps(); cache = dict(KNOWN)
    try: cache.update(json.loads(STATE.read_text()))
    except (FileNotFoundError, json.JSONDecodeError): pass
    for appid in apps:
        if appid not in cache:
            try: cache[appid] = store_says_vr(appid)
            except Exception: continue
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(cache, indent=2, sort_keys=True) + "\n")
    vr = {appid for appid in apps if cache.get(appid) is True}
    for config in (STEAM / "userdata").glob("[0-9]*/config/localconfig.vdf"):
        patch_localconfig(config, vr)
    return 0

if __name__ == "__main__": sys.exit(main())
