#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

# AMD's compute compositor needs CAP_SYS_NICE for its high-priority Vulkan
# queue. Runtime rebuilds replace the executable and silently discard file
# capabilities, so ask the narrowly-scoped system helper to repair it before
# every AMD session and then verify the result ourselves.
monado_service="$MONADO_PREFIX/bin/monado-service"
if [[ "$AMD_VULKAN_DEVICE" == 1002:* ]]; then
    capability=$(getcap "$monado_service" 2>/dev/null || true)
    if [[ "$capability" != *'cap_sys_nice=eip'* ]]; then
        systemctl start "psvr2-monado-capability@$(id -u).service" 2>/dev/null || true
        capability=$(getcap "$monado_service" 2>/dev/null || true)
    fi
    [[ "$capability" == *'cap_sys_nice=eip'* ]] ||
        echo "WARN Monado lacks CAP_SYS_NICE; reinstall the PSVR2 system integration." >&2
fi

# Use Monado's Sony-driver bridge for complete HMD and Sense optical tracking.
# This loads the driver through Ignition; it does not launch Valve's SteamVR runtime.
export STEAMVR_LH_ENABLE=true
export LH_LOAD_LIGHTHOUSE=false
export LH_LOAD_PSVR2=1
export LH_DISCOVER_WAIT_MS=5000
export STEAMVR_PATH="$STEAM_ROOT/steamapps/common/SteamVR"
export PROTONPREFIX="$PSVR2_SETUP_ROOT/ignition-prefix"
export PROTONVERSION="Proton - Experimental"
export XRT_COMPOSITOR_SCALE_PERCENTAGE="$PSVR2_RENDER_SCALE"
export XRT_COMPOSITOR_COMPUTE=1
# Monado's native compositor does not currently publish room-scale extents.
# Derive the enclosing OpenXR stage rectangle from the same polygon used by
# xr-chaperone so applications see the play area configured by Room Setup.
boundary_file="${PSVR2_CHAPERONE_CONFIG:-$HOME/.config/xr-chaperone/chaperone.toml}"
if [[ -r "$boundary_file" ]]; then
    read -r stage_width stage_depth < <(
        awk -F= '
            /^[[:space:]]*x[[:space:]]*=/ {
                value = $2 + 0
                if (!have_x || value < min_x) min_x = value
                if (!have_x || value > max_x) max_x = value
                have_x = 1
            }
            /^[[:space:]]*z[[:space:]]*=/ {
                value = $2 + 0
                if (!have_z || value < min_z) min_z = value
                if (!have_z || value > max_z) max_z = value
                have_z = 1
            }
            END {
                if (have_x && have_z && max_x > min_x && max_z > min_z)
                    printf "%.6f %.6f\n", max_x - min_x, max_z - min_z
            }
        ' "$boundary_file"
    )
    if [[ -n "${stage_width:-}" && -n "${stage_depth:-}" ]]; then
        export XRT_STAGE_BOUNDS_WIDTH="$stage_width"
        export XRT_STAGE_BOUNDS_HEIGHT="$stage_depth"
    fi
fi
# Use Monado's direct compositor mirror rather than a second capture/render
# path. This window belongs to the runtime process, so disconnect teardown
# cannot leave a spectator process behind.
unset XRT_WINDOW_PEEK
if [[ "$PSVR2_SPECTATOR_ENABLE" == 1 ]]; then
    export XRT_DEBUG_GUI=1 XRT_CURATED_GUI=1 XRT_SPECTATOR_MODE=1
    # XWayland gives the dGPU-backed OpenGL mirror a reliable presentation path
    # on GNOME Wayland while the HMD remains on Vulkan direct display.
    export SDL_VIDEODRIVER=x11
else
    export XRT_DEBUG_GUI=0 XRT_CURATED_GUI=0 XRT_SPECTATOR_MODE=0
fi
export XRT_COMPOSITOR_FORCE_VK_DISPLAY=0
export XRT_COMP_FRAME_LAG_LOG_AS_LEVEL=warn
export U_PACING_APP_USE_MIN_FRAME_PERIOD=1
# PSVR2's AMD direct-display path needs an earlier wake than Monado's generic
# 3 ms fallback at 120 Hz. Without this, the compositor repeatedly lands one
# full 8.34 ms frame late even at low GPU utilization.
export U_PACING_COMP_MIN_TIME_MS="${PSVR2_COMPOSITOR_TIME_MS:-8}"
export XRT_NO_STDIN=1
export IPC_EXIT_ON_DISCONNECT=OFF
if [[ -n "$AMD_VULKAN_DEVICE" ]]; then
    export MESA_VK_DEVICE_SELECT="${AMD_VULKAN_DEVICE}!"
    export MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE=1
fi
if [[ -n "$DGPU_PCI_ADDRESS" ]]; then
    export DRI_PRIME="pci-${DGPU_PCI_ADDRESS//:/_}"
    export DRI_PRIME="${DRI_PRIME//./_}"
fi
exec "$monado_service"
