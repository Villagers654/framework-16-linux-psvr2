#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

# Keep SteamVR Lighthouse base-station support disabled unless explicitly enabled.
# Keep PSVR2 Sense discovery enabled by default because it carries controller input.
psvr2_sense="${PSVR2_LOAD_PSVR2_SENSE:-${LH_LOAD_PSVR2:-1}}"
export STEAMVR_LH_ENABLE="${PSVR2_ENABLE_STEAMVR_LH:-0}"
if [[ "${PSVR2_ENABLE_STEAMVR_LH:-0}" == "1" ]]; then
    export LH_LOAD_LIGHTHOUSE=true
else
    export LH_LOAD_LIGHTHOUSE=false
fi
case "$psvr2_sense" in
    0|false|FALSE|off|OFF|disabled|DISABLED|no|NO) export LH_LOAD_PSVR2=false ;;
    *) export LH_LOAD_PSVR2=true ;;
esac
export LH_DISCOVER_WAIT_MS=5000
export XRT_COMPOSITOR_SCALE_PERCENTAGE="$PSVR2_RENDER_SCALE"
export XRT_COMPOSITOR_COMPUTE=1
# Never inherit the abandoned experimental window-peek mirror path.
unset XRT_WINDOW_PEEK
if [[ "$PSVR2_SPECTATOR_ENABLE" = 1 ]]; then
    export XRT_DEBUG_GUI=1 XRT_CURATED_GUI=1 XRT_SPECTATOR_MODE=1
    # XWayland gives the dGPU-backed OpenGL mirror a reliable presentation path
    # on GNOME Wayland while the headset remains on Monado's direct display.
    export SDL_VIDEODRIVER=x11
else
    export XRT_DEBUG_GUI=0 XRT_CURATED_GUI=0
fi
export XRT_COMPOSITOR_FORCE_VK_DISPLAY=0
export XRT_COMP_FRAME_LAG_LOG_AS_LEVEL=debug
export U_PACING_APP_USE_MIN_FRAME_PERIOD=1
# Reserve enough of each 8.34 ms frame for AMD timewarp/reprojection. Monado's
# 4 ms default can miss the 120 Hz deadline under otherwise-manageable load.
export U_PACING_COMP_MIN_TIME_MS="${PSVR2_COMPOSITOR_TIME_MS:-8}"
export XRT_NO_STDIN=1
export IPC_EXIT_ON_DISCONNECT=OFF
if [[ -n "$AMD_VULKAN_DEVICE" ]]; then
    export MESA_VK_DEVICE_SELECT="${AMD_VULKAN_DEVICE}!"
    export MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE=1
fi
if [[ -n "$DGPU_PCI_ADDRESS" ]]; then
    export DRI_PRIME="pci-${DGPU_PCI_ADDRESS//:/_}"
    export DRI_PRIME="${DRI_PRIME//./_}"
fi
exec "$MONADO_PREFIX/bin/monado-service"
