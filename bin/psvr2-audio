#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

state_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psvr2-audio-restore"

node_id() {
    local escaped=${1//./\.}
    wpctl status -n | sed -n "s/.*[^0-9]\([0-9][0-9]*\)\. ${escaped}[[:space:]].*/\1/p" | head -n 1
}

set_default_when_ready() {
    local name=$1 unmute=${2:-0} id
    [[ -n "$name" ]] || return 0
    for _ in $(seq 1 50); do
        id=$(node_id "$name" || true)
        if [[ -n "$id" ]]; then
            wpctl set-default "$id"
            [[ "$unmute" != 1 ]] || wpctl set-mute "$id" 0
            return 0
        fi
        sleep 0.2
    done
    echo "PSVR2 audio node did not appear: $name" >&2
    return 1
}

case "${1:-}" in
    vr)
        current=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null |
            sed -n 's/^[[:space:]]*\*\{0,1\}[[:space:]]*node.name = "\([^"]*\)"/\1/p' |
            head -n 1)
        # Repeated readiness checks must not replace the real desktop restore
        # target with the PSVR2 sink itself.
        if [[ -n "$current" && "$current" != "$VR_AUDIO_SINK" ]]; then
            printf '%s\n' "$current" > "$state_file"
        fi
        set_default_when_ready "$VR_AUDIO_SINK" 1
        set_default_when_ready "$VR_AUDIO_SOURCE"
        ;;
    restore)
        if [[ -s "$state_file" ]]; then
            read -r previous < "$state_file"
            id=$(node_id "$previous" || true)
            [[ -z "$id" ]] || wpctl set-default "$id"
        fi
        ;;
    *) echo "Usage: psvr2-audio {vr|restore}" >&2; exit 2 ;;
esac
