#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

usage() {
    cat <<'USAGE'
Usage:
  psvr2-chaperone [service|configure]

service    (default) run xr-chaperone in service mode (-s)
configure  run xr-chaperone setup wizard on the host monitor
status     print current effective settings
USAGE
}

mode=service
if [[ "${1:-}" == "configure" || "${1:-}" == "--configure" ]]; then
    mode=configure
elif [[ "${1:-}" == "status" ]]; then
    echo "enabled=$PSVR2_CHAPERONE_ENABLE"
    echo "binary=$PSVR2_CHAPERONE_BINARY"
    echo "service_args=${PSVR2_CHAPERONE_SERVICE_ARGS:-}"
    exit 0
elif [[ "${1:-}" == "service" || "${1:-}" == "--service" || -z "${1:-}" ]]; then
    mode=service
elif [[ -n "${1:-}" ]]; then
    usage
    exit 2
fi

binary="$PSVR2_CHAPERONE_BINARY"
if [[ ! -f "$binary" ]]; then
    echo "PSVR2 chaperone binary not found: $binary" >&2
    echo "Run ./scripts/build-xr-chaperone.sh to build xr-chaperone." >&2
    exit 1
fi
if [[ ! -x "$binary" ]]; then
    chmod +x "$binary"
fi

if [[ "$mode" == "service" && "${PSVR2_CHAPERONE_ENABLE:-0}" != "1" ]]; then
    echo "PSVR2 chaperone is disabled in settings.env"
    exit 0
fi

if [[ "$mode" == "service" ]]; then
    importer="${PSVR2_HELPER_DIR:-$HOME/.local/bin}/psvr2-import-boundary"
    [[ ! -x "$importer" ]] || "$importer"
fi

export XR_RUNTIME_JSON="$MONADO_PREFIX/share/openxr/1/openxr_monado.json"
export PRESSURE_VESSEL_IMPORT_OPENXR_1_RUNTIMES=1

# xr-chaperone loads the unversioned OpenXR loader name at runtime. Immutable
# hosts may have only the versioned runtime library until their staged
# openxr-devel deployment is booted, while the tested build toolchain already
# provides the loader through Homebrew.
openxr_loader_cache=$(ldconfig -p 2>/dev/null || true)
if ! grep -Eq '^[[:space:]]*libopenxr_loader[.]so[[:space:]]' <<<"$openxr_loader_cache"; then
    brew_command=$(command -v brew 2>/dev/null || true)
    if [[ -z "$brew_command" && -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        brew_command=/home/linuxbrew/.linuxbrew/bin/brew
    fi
    if [[ -n "$brew_command" ]]; then
        openxr_prefix=$("$brew_command" --prefix openxr 2>/dev/null || true)
        if [[ -f "$openxr_prefix/lib/libopenxr_loader.so" ]]; then
            export LD_LIBRARY_PATH="$openxr_prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        fi
    fi
fi

read -r -a extra_args <<<"${PSVR2_CHAPERONE_SERVICE_ARGS:-}"

case "$mode" in
    configure)
        "$binary"
        ;;
    service)
        if ! printf '%s\\n' "${extra_args[*]}" | grep -q -- '-s'; then
            extra_args+=("-s")
        fi
        "$binary" "${extra_args[@]}"
        ;;
    *)
        usage
        exit 2
        ;;
esac
