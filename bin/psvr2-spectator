#!/usr/bin/bash
set -euo pipefail

unit=psvr2-fossvr.service
dropin_dir="$HOME/.config/systemd/user/${unit}.d"
dropin="$dropin_dir/50-spectator.conf"
settings_dir="$HOME/.config/psvr2-linux"
settings="$settings_dir/settings.env"
restart=true

usage() {
    cat <<'EOF'
Usage: psvr2-spectator on|off|toggle|status [--no-restart]

The choice persists across reboots and headset reconnects. If VR is running,
it is cleanly restarted by default so the change takes effect immediately.
EOF
}

effective_enabled() {
    systemctl --user show "$unit" -p Environment --value 2>/dev/null |
        tr ' ' '\n' | grep -Fxq 'XRT_SPECTATOR_MODE=1'
}

set_settings_value() {
    local value=$1
    install -d -m 0700 "$settings_dir"
    if [[ -f "$settings" ]] && grep -q '^PSVR2_SPECTATOR_ENABLE=' "$settings"; then
        sed -i "s/^PSVR2_SPECTATOR_ENABLE=.*/PSVR2_SPECTATOR_ENABLE=$value/" "$settings"
    else
        printf '\nPSVR2_SPECTATOR_ENABLE=%s\n' "$value" >> "$settings"
        chmod 0600 "$settings"
    fi
}

apply_state() {
    local value=$1
    local was_active=false
    systemctl --user is-active --quiet "$unit" && was_active=true

    install -d -m 0755 "$dropin_dir"
    local tmp
    tmp=$(mktemp "$dropin_dir/.50-spectator.conf.XXXXXX")
    if [[ "$value" = 1 ]]; then
        printf '%s\n' \
            '[Service]' \
            'Environment="XRT_DEBUG_GUI=1"' \
            'Environment="XRT_CURATED_GUI=1"' \
            'Environment="XRT_SPECTATOR_MODE=1"' \
            'UnsetEnvironment=XRT_WINDOW_PEEK' \
            'Environment="SDL_VIDEODRIVER=x11"' > "$tmp"
    else
        printf '%s\n' \
            '[Service]' \
            'Environment="XRT_DEBUG_GUI=0"' \
            'Environment="XRT_CURATED_GUI=0"' \
            'Environment="XRT_SPECTATOR_MODE=0"' \
            'UnsetEnvironment=XRT_WINDOW_PEEK' > "$tmp"
    fi
    chmod 0644 "$tmp"
    mv -f "$tmp" "$dropin"
    set_settings_value "$value"
    systemctl --user daemon-reload

    if $was_active && $restart; then
        if [[ -x "$HOME/.local/bin/psvr2-fossvr-stop" && -x "$HOME/.local/bin/psvr2-fossvr-start" ]]; then
            "$HOME/.local/bin/psvr2-fossvr-stop"
            "$HOME/.local/bin/psvr2-fossvr-start"
        else
            systemctl --user restart "$unit"
        fi
    fi

    local word=disabled
    [[ "$value" = 1 ]] && word=enabled
    echo "PSVR2 spectator view: $word (persistent)"
    $was_active && ! $restart && echo "The running VR session is unchanged; this applies on its next start."
    command -v notify-send >/dev/null && notify-send "PSVR2 spectator view" "$word persistently" || true
}

action=""
for arg in "$@"; do
    case "$arg" in
        on|enable|off|disable|toggle|status) action=$arg ;;
        --no-restart) restart=false ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

[[ -n "$action" ]] || { usage >&2; exit 2; }
case "$action" in
    status)
        if effective_enabled; then
            echo "PSVR2 spectator view: enabled (persistent)"
        else
            echo "PSVR2 spectator view: disabled (persistent)"
        fi
        ;;
    on|enable) apply_state 1 ;;
    off|disable) apply_state 0 ;;
    toggle)
        if effective_enabled; then apply_state 0; else apply_state 1; fi
        ;;
esac
