#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

# UnitySetup can retain a bad initial camera/reference transform in its
# per-application Unity state after an interrupted run or tracking-origin
# transition. This is disposable app state: the SLAM map and play area are
# stored by the PSVR2 driver elsewhere. Start clean and reject double launches.
lock_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec 9>"$lock_dir/psvr2-room-setup.lock"
if ! flock -n 9; then
    echo "PSVR2 Room Setup is already running." >&2
    exit 0
fi

for state_dir in \
    "$HOME/.config/unity3d/Bnuuy Solutions/PSVR2Toolkit.UnitySetup" \
    "$HOME/.cache/unity3d/Bnuuy Solutions/PSVR2Toolkit.UnitySetup"; do
    if [[ -d "$state_dir" ]]; then
        find "$state_dir" -mindepth 1 -delete
    fi
done

helper_dir="${PSVR2_HELPER_DIR:-$HOME/.local/bin}"
"$helper_dir/psvr2-fossvr-start"

# The live camera mesh is created from the HMD pose captured when Unity starts.
# After boot/relocalization the driver can report a valid-looking pose and then
# jump to its latched map origin. Starting in that window permanently distorts
# passthrough for this process. Require either the legacy "stable" transition
# or the current driver's fully tracked HMD sample, followed by a jump-free
# settling window, before xrizer creates Room Setup's raw reference space.
service_since=$(systemctl --user show psvr2-fossvr.service \
    --property=ActiveEnterTimestamp --value)
tracking_ready=false
chaperone="$STEAM_ROOT/config/playstation_vr2/chaperone_info.vrchap"
boundary_meta="$STEAM_ROOT/config/playstation_vr2/sceBoundaryMeta.bin"
map_database="$STEAM_ROOT/config/playstation_vr2/sceMapDb.bin"
calibration_files=("$chaperone" "$boundary_meta" "$map_database")
if [[ ! -e "$chaperone" ]] || { \
    [[ -r "$chaperone" ]] \
    && grep -Eq '"play_area"[[:space:]]*:[[:space:]]*\[[[:space:]]*0([.]0+)?[[:space:]]*,[[:space:]]*0([.]0+)?[[:space:]]*\]' "$chaperone" \
    && grep -Eq '"collision_bounds"[[:space:]]*:[[:space:]]*null' "$chaperone"; }; then
    # A factory-fresh calibration has no standing transform to capture
    # incorrectly, and Room Setup itself is what creates the first stable map.
    tracking_ready=true
else
    for _ in $(seq 1 60); do
        tracking_log=$(journalctl --user -u psvr2-fossvr.service \
            --since "$service_since" --no-pager 2>/dev/null \
            | grep -E 'TrackingStatus|\[HMD\] (Track|Jump|Lost)|map registration error' \
            | tail -n 400 || true)
        # Older releases explicitly transitioned to "stable". The current
        # Sony bridge instead remains in its map-search state while publishing
        # usable 6DoF HMD samples; state tuple 2/1/4 is its fully tracked pose.
        if grep -Eq 'TrackingStatus.*-> stable|\[HMD\] Track at p:.*\(st: 2 1 4\)' \
            <<<"$tracking_log"; then
            sleep 3
            if ! journalctl --user -u psvr2-fossvr.service \
                --since '4 seconds ago' --no-pager 2>/dev/null \
                | grep -Eq '\[HMD\] (Jump|Lost)|TrackingStatus.*-> (unstable|lost)|map registration error 0 -> 1'; then
                tracking_ready=true
                break
            fi
        fi
        sleep 1
    done
fi
if [[ "$tracking_ready" != true ]]; then
    notify-send 'PSVR2 Room Setup' \
        'Waiting for headset tracking timed out. Look around the room and launch Room Setup again.' \
        2>/dev/null || true
    echo 'PSVR2 tracking did not stabilize; refusing to capture a broken camera reference.' >&2
    exit 1
fi

# Room Setup deliberately asks the user to place the HMD on the floor and can
# move the driver's live tracking origin before it commits the new chaperone
# file.  An already-running xr-chaperone session keeps its old STAGE space in
# that interval, which makes the saved floor boundary appear at chest height.
# Hide the stale overlay throughout calibration; it will be recreated against
# the reloaded runtime below.
chaperone_was_active=false
if systemctl --user is-active --quiet psvr2-chaperone.service; then
    chaperone_was_active=true
    systemctl --user stop psvr2-chaperone.service
fi
restore_chaperone() {
    if [[ "$chaperone_was_active" == true ]] \
        && systemctl --user is-active --quiet psvr2-fossvr.service; then
        systemctl --user start psvr2-chaperone.service 2>/dev/null || true
    fi
}
trap restore_chaperone EXIT

roomsetup_env=()
roomsetup_env+=("PSVR2_ROOM_SETUP_LAUNCH=1")
roomsetup_env+=("XRIZER_FORCE_HEADSET_ON_HEAD=1")
# The Toolkit camera feed is published in the PSVR2 driver's raw tracking
# universe.  Scope raw-space emulation to this Room Setup launch only; games
# keep STAGE space.
roomsetup_env+=("XRIZER_FORCE_RAW_TRACKING_SPACE=1")
roomsetup_env+=("XRIZER_RAW_CHAPERONE_PATH=$STEAM_ROOT/config/playstation_vr2/chaperone_info.vrchap")

# Both the SteamVR-driver bridge and xrizer capture the standing/raw transform
# when their processes start.  Room Setup changes that transform when a wizard
# finishes.  Continuing in either process after the save mixes the old device
# origin with the new boundary and can put the floor above the user's head.
# Watch for a complete, stable chaperone write, close the now-stale setup
# process, and reload the runtime so every component adopts the same origin.
file_digest() {
    local file=$1
    if [[ -r "$file" ]]; then
        sha256sum "$file" | cut -d ' ' -f 1
    else
        printf 'missing\n'
    fi
}

calibration_digest() {
    local file
    for file in "${calibration_files[@]}"; do
        printf '%s:%s\n' "$(basename "$file")" "$(file_digest "$file")"
    done
}

valid_play_area() {
    [[ -r "$chaperone" ]] \
        && grep -Eq '"collision_bounds"[[:space:]]*:[[:space:]]*\[' "$chaperone" \
        && ! grep -Eq '"play_area"[[:space:]]*:[[:space:]]*\[[[:space:]]*0([.]0+)?[[:space:]]*,[[:space:]]*0([.]0+)?[[:space:]]*\]' "$chaperone"
}

# Room Setup commits the boundary polygon, its universe metadata, and the
# camera relocalization map separately. Preserve the last complete set before
# starting so an interrupted save can never replace a working calibration.
backup_root="$PSVR2_SETUP_ROOT/room-calibration-backups"
backup_dir="$backup_root/$(date +%Y%m%d-%H%M%S)"
install -d -m 0700 "$backup_dir"
for file in "${calibration_files[@]}"; do
    [[ ! -e "$file" ]] || cp -a -- "$file" "$backup_dir/"
done

initial_digest=$(calibration_digest)

env "${roomsetup_env[@]}" \
    "$helper_dir/psvr2-fossvr-run" \
    "$PSVR2_SETUP_ROOT/unity-setup/PSVR2Toolkit.UnitySetup.x86_64" &
runner_pid=$!
calibration_changed=false
candidate_digest=
stable_checks=0

while kill -0 "$runner_pid" 2>/dev/null; do
    current_digest=$(calibration_digest)
    all_state_present=true
    for file in "${calibration_files[@]}"; do
        [[ -s "$file" ]] || all_state_present=false
    done
    all_state_changed=true
    while IFS= read -r initial_line; do
        grep -Fxq "$initial_line" <<<"$current_digest" && all_state_changed=false
    done <<<"$initial_digest"

    if [[ "$all_state_present" == true && "$all_state_changed" == true ]] \
        && valid_play_area; then
        if [[ "$current_digest" == "$candidate_digest" ]]; then
            ((stable_checks += 1))
        else
            candidate_digest=$current_digest
            stable_checks=1
        fi
        # The map is roughly 20 MiB and is flushed after the small JSON and
        # metadata files. Require ten seconds with no changes across the
        # complete set before allowing the runtime reload to consume it.
        if (( stable_checks >= 20 )); then
            calibration_changed=true
            kill -TERM "$runner_pid" 2>/dev/null || true
            break
        fi
    else
        candidate_digest=
        stable_checks=0
    fi
    sleep 0.5
done

set +e
wait "$runner_pid"
setup_status=$?
set -e

if [[ "$calibration_changed" != true ]] && [[ "$(calibration_digest)" != "$initial_digest" ]]; then
    # A partial transaction is worse than an old but internally consistent
    # room map. Restore only files that existed in the pre-run snapshot and
    # remove newly-created fragments before restarting the runtime.
    for file in "${calibration_files[@]}"; do
        saved="$backup_dir/$(basename "$file")"
        if [[ -e "$saved" ]]; then
            cp -a -- "$saved" "$file"
        else
            rm -f -- "$file"
        fi
    done
    notify-send -u critical 'PSVR2 play area was not saved' \
        'Room Setup did not commit a complete spatial map; the previous calibration was restored.' \
        2>/dev/null || true
    setup_status=1
fi

if [[ "$calibration_changed" == true ]]; then
    notify-send 'PSVR2 play area saved' \
        'Reloading the VR origin and returning to WayVR.' 2>/dev/null || true
fi

# The Toolkit mutates the driver's in-memory raw/standing origin as soon as its
# floor step runs, even if the wizard is later cancelled and the on-disk file
# never changes. A fresh Monado process is therefore required after *every*
# Room Setup run, not only after a successful save. Otherwise that transient
# floor pose leaks into xr-chaperone and all subsequent games.
PSVR2_DISCONNECT_CONTROLLERS=0 "$helper_dir/psvr2-fossvr-stop"
"$helper_dir/psvr2-import-boundary"
# The proprietary driver releases several PSVR2 USB interfaces
# asynchronously. Give them time to settle before reacquiring the HMD.
sleep 6
started=false
for _ in 1 2 3; do
    if "$helper_dir/psvr2-fossvr-start"; then
        started=true
        break
    fi
    sleep 5
done
if [[ "$started" != true ]]; then
    notify-send -u critical 'PSVR2 reload failed' \
        'Power-cycle the headset, then run psvr2-fossvr-start.' 2>/dev/null || true
    exit 1
fi
if [[ "$calibration_changed" == true ]]; then
    exit 0
fi

exit "$setup_status"
