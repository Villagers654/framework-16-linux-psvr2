#!/usr/bin/bash
set -euo pipefail
source "$HOME/.local/lib/psvr2-linux/common.sh"

bluetoothctl_bin=$(command -v bluetoothctl 2>/dev/null || true)
required_left="${PSVR2_REQUIRED_LEFT_CONTROLLER:-0}"
required_right="${PSVR2_REQUIRED_RIGHT_CONTROLLER:-0}"
[[ -n "$bluetoothctl_bin" ]] || { echo "PSVR2: bluetoothctl unavailable; skipping controller presence check"; exit 0; }

hid_present() {
    local product=$1 file
    for file in /sys/class/hidraw/hidraw*/device/uevent; do
        [[ -r "$file" ]] || continue
        grep -Fq "HID_ID=0005:0000054C:0000${product}" "$file" && return 0
    done
    return 1
}

controller_ready() {
    local address=$1 product=$2
    [[ -n "$address" ]] || return 1

    local info
    info=$($bluetoothctl_bin info "$address" 2>/dev/null) || return 1
    grep -Fq 'Connected: yes' <<<"$info" || return 1
    hid_present "$product"
}

controller_ready_named() {
    local product=$1 target_name=$2
    local line address name
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        address=$(awk '{print $2; exit}' <<<"$line")
        name=$(awk '{$1=$2=""; sub(/^  /, "", $0); print $0}' <<<"$line")
        [[ -z "$address" ]] && continue
        [[ -z "$name" ]] && continue
        if [[ "$name" == *"$target_name"* ]] && controller_ready "$address" "$product"; then
            return 0
        fi
    done < <("$bluetoothctl_bin" devices 2>/dev/null)
    return 1
}

check_controller_side() {
    local product=$1 side=$2 mac_var=$3 required=$4
    local mac

    mac="${!mac_var:-}"

    if [[ -n "$mac" ]] && controller_ready "$mac" "$product"; then
        return 0
    fi

    case "$side" in
        left)
            if controller_ready_named "$product" "PlayStation VR2 Sense Controller (L)"; then return 0; fi
            if controller_ready_named "$product" "PS VR2 Sense Controller (L)"; then return 0; fi
            if controller_ready_named "$product" "Sense Controller (L)"; then return 0; fi
            if controller_ready_named "$product" "PlayStation VR2 Sense Controller"; then return 0; fi
            ;;
        right)
            if controller_ready_named "$product" "PlayStation VR2 Sense Controller (R)"; then return 0; fi
            if controller_ready_named "$product" "PS VR2 Sense Controller (R)"; then return 0; fi
            if controller_ready_named "$product" "Sense Controller (R)"; then return 0; fi
            if controller_ready_named "$product" "PlayStation VR2 Sense Controller"; then return 0; fi
            ;;
    esac

    if (( required == 1 )); then
        echo "PSVR2: ${side^} Sense controller not fully ready yet"
    fi
    return 1
}

fail=0
if ! check_controller_side 0E45 left CONTROLLER_LEFT_MAC "$required_left"; then
    (( required_left == 1 )) && fail=1
fi
if ! check_controller_side 0E46 right CONTROLLER_RIGHT_MAC "$required_right"; then
    (( required_right == 1 )) && fail=1
fi

if (( fail == 1 )); then
    exit 1
fi
exit 0
