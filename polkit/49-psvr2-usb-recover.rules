// Permit the active local desktop user to request only the narrowly scoped
// PSVR2 USB recovery unit. The unit and root-owned helper validate the device.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "psvr2-usb-recover.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "restart") &&
        subject.active && subject.local) {
        return polkit.Result.YES;
    }
});
