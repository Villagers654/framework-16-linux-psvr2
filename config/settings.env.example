# General Linux PSVR2 settings
PSVR2_RENDER_SCALE=170
PSVR2_REFRESH_RATE=120
STEAM_ROOT="$HOME/.local/share/Steam"
ENVISION_PROFILE_ROOT="$HOME/.local/share/envision/psvr2-toolkit-monado"
MONADO_PREFIX="$HOME/.local/share/envision/prefixes/psvr2-toolkit-monado"
PSVR2_SETUP_ROOT="$HOME/.local/share/psvr2-setup"

# Framework 16 RX 7700S / AMD settings.
# Leave blank on other hardware and fill with values from scripts/detect-hardware.sh.
AMD_VULKAN_DEVICE="1002:7480"
DGPU_PCI_ADDRESS="0000:03:00.0"

# Optional stable PipeWire names. This output is the Framework 16 RX 7700S
# expansion-bay DisplayPort path; clear or replace it on other hardware.
VR_AUDIO_SINK="alsa_output.pci-0000_03_00.1.hdmi-stereo-extra3"
VR_AUDIO_SOURCE=""

# Optional controller MACs. Pairing works without storing them here; providing
# them enables repair of BlueZ's rare Connected=yes but missing-HID state.
CONTROLLER_LEFT_MAC=""
CONTROLLER_RIGHT_MAC=""

# Bazzite uses its Steam wrapper. Other distributions normally use `steam`.
STEAM_COMMAND="/usr/bin/bazzite-steam"
