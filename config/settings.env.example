# General Linux PSVR2 settings
PSVR2_RENDER_SCALE=170
PSVR2_REFRESH_RATE=120
# Milliseconds reserved for Monado's final timewarp/reprojection pass. The
# Linux VR Adventures recommendation for AMD systems with pacing symptoms is 8.
PSVR2_COMPOSITOR_TIME_MS=8
# Fullscreen laptop spectator view using Monado's GPU-native left-eye image.
PSVR2_SPECTATOR_ENABLE=1
# OpenXR chaperone warning overlay (visual boundary + fade).
# 1 enables a service overlay in every VR app; 0 disables it.
PSVR2_CHAPERONE_ENABLE=1
PSVR2_CHAPERONE_BINARY="${PSVR2_SETUP_ROOT:-$HOME/.local/share/psvr2-setup}/xr-chaperone/xr-chaperone"
PSVR2_CHAPERONE_SERVICE_ARGS="-s"
# Connection stability tuning for noisy USB/DP wake-ups on certain hubs/adapters.
PSVR2_LINK_STABILITY_CHECKS=4
PSVR2_LINK_DISCONNECT_CHECKS=2
PSVR2_LINK_STABILITY_INTERVAL_SECONDS=1
PSVR2_STARTUP_RETRY_BASE_SECONDS=12
PSVR2_STARTUP_RETRY_MAX_SECONDS=120
PSVR2_STARTUP_RETRY_ATTEMPTS=3
PSVR2_RUNTIME_RETRY_COOLDOWN_SECONDS=90
# After repeated runtime creation failures, pause longer and run a full VR stack
# recycle to recover from stale USB/driver state before retrying.
PSVR2_RUNTIME_FAILURE_STREAK_THRESHOLD=2
PSVR2_RUNTIME_FAILURE_RECOVERY_SECONDS=90
PSVR2_USB_INTERFACE_MINIMUM=11
STEAM_ROOT="$HOME/.local/share/Steam"
ENVISION_PROFILE_ROOT="$HOME/.local/share/envision/psvr2-toolkit-monado"
MONADO_PREFIX="$HOME/.local/share/envision/prefixes/psvr2-toolkit-monado"
PSVR2_SETUP_ROOT="$HOME/.local/share/psvr2-setup"
# Force PSVR2 Sense controller discovery inside the Monado PSVR2 driver.
# Keep enabled unless you want a headset-only fallback.
PSVR2_LOAD_PSVR2_SENSE=1

# Optional manual override list for legacy launch modes that fail VR autodetect.
# This is a legacy fallback and should usually be left empty.
PSVR2_FORCE_VR_IDS=""
# WayVR launches Steam's VR action, while this integration supplies the Monado
# environment through per-game Steam launch options. Set to 0 if you manage
# those launch options yourself; the installer always keeps a one-time backup.
PSVR2_MANAGE_STEAM_LAUNCH_OPTIONS=1

# Framework 16 RX 7700S / AMD settings.
# Leave blank on other hardware and fill with values from scripts/detect-hardware.sh.
AMD_VULKAN_DEVICE="1002:7480"
DGPU_PCI_ADDRESS="0000:03:00.0"

# Optional stable PipeWire names. This output is the Framework 16 RX 7700S
# expansion-bay DisplayPort path; clear or replace it on other hardware.
VR_AUDIO_SINK="alsa_output.pci-0000_03_00.1.hdmi-stereo-extra3"
VR_AUDIO_SOURCE=""

# Optional controller MACs. Pairing works without storing them here; providing
# them enables repair of BlueZ's rare Connected=yes but missing-HID state.
CONTROLLER_LEFT_MAC=""
CONTROLLER_RIGHT_MAC=""

# Keep Sense controllers connected when Monado stops so you can move/repair them
# from your headset or system Bluetooth stack without a reconnect pass.
# Set to 1 only if your firmware/BT stack requires a hard disconnect on stop.
PSVR2_DISCONNECT_CONTROLLERS=0

# Bazzite uses its Steam wrapper. Other distributions normally use `steam`.
STEAM_COMMAND="/usr/bin/bazzite-steam"
