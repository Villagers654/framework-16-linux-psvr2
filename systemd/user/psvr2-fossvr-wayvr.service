[Unit]
Description=WayVR dashboard for the PSVR2 Monado runtime
Documentation=https://wiki.vronlinux.org/docs/fossvr/wayvr/
Requires=psvr2-fossvr.service
After=psvr2-fossvr.service
PartOf=psvr2-fossvr.service

[Service]
Type=simple
ExecStart=%h/.local/bin/psvr2-wayvr --openxr --replace
# The connection monitor owns recovery.  If Monado fails, restarting this
# Requires= client would implicitly start Monado again without the lifecycle
# lock, preflight, device health check, or USB recovery.  That creates a
# compositor/socket restart storm precisely while the headset is least ready.
Restart=no
TimeoutStopSec=5
