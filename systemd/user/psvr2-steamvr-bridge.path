[Unit]
Description=Watch PSVR2 SteamVR files for updates

[Path]
PathChanged=%h/.local/share/Steam/steamapps/common/SteamVR/bin/vrenv.sh
PathChanged=%h/.local/share/Steam/steamapps/common/SteamVR/bin/linux64/vrcompositor-launcher.sh
Unit=psvr2-steamvr-bridge.service

[Install]
WantedBy=default.target
