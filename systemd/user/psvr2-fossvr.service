[Unit]
Description=PSVR2 Toolkit + Monado high-performance OpenXR runtime
Documentation=https://wiki.vronlinux.org/docs/hardware/psvr2/
After=graphical-session.target bluetooth.target
Conflicts=monado.service monado.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/psvr2-monado-service
Restart=no
RestartSec=2
TimeoutStopSec=10
KillMode=control-group
# Keep the latency-sensitive compositor and tracking bridge ahead of ordinary
# application cgroups without imposing unsafe CPU affinity or RT policy on the
# proprietary tracking server.
CPUWeight=10000
IOWeight=1000

[Install]
WantedBy=default.target
