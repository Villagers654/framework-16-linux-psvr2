#!/usr/bin/bash
set -euo pipefail

state_file=/run/psvr2-dgpu-power.devices
case "${1:-}" in
  on)
    : > "$state_file"
    for card in /sys/class/drm/card[0-9]; do
      device=$(readlink -f "$card/device")
      [[ "$(cat "$device/vendor" 2>/dev/null || true)" == "0x1002" ]] || continue
      [[ "$(cat "$device/boot_vga" 2>/dev/null || true)" == "0" ]] || continue
      echo on > "$device/power/control"
      [[ ! -w "$device/power_dpm_force_performance_level" ]] || echo manual > "$device/power_dpm_force_performance_level"
      if [[ -w "$device/pp_power_profile_mode" ]]; then
        vr_profile=$(awk 'NR == 1 { for (i=1; i<=NF; i++) if ($i == "VR") { print $(i-1); exit } }' "$device/pp_power_profile_mode")
        [[ -z "$vr_profile" ]] || echo "$vr_profile" > "$device/pp_power_profile_mode"
      fi
      printf '%s\n' "$device" >> "$state_file"
    done
    ;;
  auto)
    if [[ -r "$state_file" ]]; then
      while IFS= read -r device; do
        [[ ! -w "$device/pp_power_profile_mode" ]] || echo 0 > "$device/pp_power_profile_mode"
        [[ ! -w "$device/power_dpm_force_performance_level" ]] || echo auto > "$device/power_dpm_force_performance_level"
        [[ ! -w "$device/power/control" ]] || echo auto > "$device/power/control"
      done < "$state_file"
      rm -f "$state_file"
    fi
    ;;
  *) echo "usage: $0 on|auto" >&2; exit 2 ;;
esac
