#!/usr/bin/bash
set -euo pipefail

usb_root=/sys/bus/usb/devices
devices=()

for candidate in "$usb_root"/*; do
    [[ -r "$candidate/idVendor" && -r "$candidate/idProduct" ]] || continue
    [[ "$(<"$candidate/idVendor"):$(<"$candidate/idProduct")" == 054c:0cde ]] || continue
    resolved=$(readlink -f -- "$candidate")
    [[ "$resolved" == /sys/devices/* && -w "$resolved/authorized" ]] || continue
    devices+=("$resolved")
done

if (( ${#devices[@]} == 0 )); then
    echo "No connected PSVR2 USB function is available to recover" >&2
    exit 1
fi

reauthorize() {
    local device
    for device in "${devices[@]}"; do
        [[ -w "$device/authorized" ]] && printf '1' > "$device/authorized" || true
    done
}
trap reauthorize EXIT

for device in "${devices[@]}"; do
    printf '0' > "$device/authorized"
done
sleep 2
reauthorize
trap - EXIT
sleep 2
